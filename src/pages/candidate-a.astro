---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/shared/SiteNav.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import { site } from '../config/site';

const stages = [
  { k: 'Reality', h: 'The world as it is.', p: 'Uneven, partially hidden, and contested.' },
  { k: 'Perception', h: 'What the sensors return.', p: 'Sparse, noisy, limited by range and line of sight.' },
  { k: 'Belief', h: 'What the machine believes.', p: 'A model of the world — including where knowledge runs out.' },
  { k: 'Risk', h: 'What could go wrong.', p: 'Terrain, ambiguous sensing, electronic warfare and the unknown, weighed together. The higher the ground, the greater the risk.' },
  { k: 'Decision', h: 'What it chooses to do.', p: 'Many possible paths. One taken, with the consequences understood.' },
];
const beats = [
  { h: 'No GPS. No light. No map.', p: 'Underground, under canopy, inside structures: where remote control fails first.' },
  { h: 'The obvious route.', p: 'Short and straight, so it starts down it. Then, up close, it sees a drop across the floor.' },
  { h: 'It backs out and takes the long way.', p: 'More than twice the distance, at a fraction of the risk. Counterintuitive, and correct.' },
  { h: 'Unknown is not the same as safe.', p: 'It commits only where the evidence supports it, and still completes the mission.' },
];
const airBeats = [
  { h: 'Low, fast, between the cliffs.', p: 'A fixed-wing machine flies the canyon, using the terrain to stay out of sight.' },
  { h: 'An emitter on the planned route.', p: 'It picks up radar ahead. Exposure becomes risk.' },
  { h: 'It changes course.', p: 'The other canyon keeps terrain between it and the radar.' },
  { h: 'Same Fieldcore OS. Different body.', p: 'On the ground or in the air, it weighs terrain, the unknown and the adversary.' },
];
const deterSteps = [
  { h: 'Autonomous capabilities at scale.', p: 'Fieldcore OS on every machine. Shunya OS across the force.' },
  { h: 'Defensive and offensive superiority.', p: 'Machines that see, decide and act where people cannot, on defence or in attack.' },
  { h: 'Deterrence through denial and punishment.', p: 'An adversary who cannot win, and cannot avoid the cost, does not start.' },
];
const forceCaps = [
  { e: '04 — Fieldcore OS', h: 'Fieldcore OS. One autonomy, many bodies.', p: 'The autonomy that runs on every machine: ground, air, legged and maritime, each with its own sense of what is risky.' },
  { e: '05 — Autonomous teams', h: 'Machines that share what they know.', p: 'One picture of the world, built together. Tasks go to the machine best placed to carry them out.' },
  { e: '06 — Human–machine teaming', h: 'Humans set intent. Machines carry it out.', p: 'Operators supervise many machines at once and stay in command of the decisions that matter.' },
  { e: '07 — Shunya OS', h: 'Shunya OS. The mission intelligence layer.', p: 'Above Fieldcore: orchestrating heterogeneous swarms, AI-assisted mission planning and fleet management, re-planning as the mission unfolds.' },
];
---

<Base theme="a" title="The Machine's Eyes">
  <SiteNav />
  <div class="gl-wrap" aria-hidden="true">
    <canvas id="a-gl" class="gl"></canvas>
    <canvas id="a-fallback" class="gl" hidden></canvas>
    <div class="vignette"></div>
  </div>
  <div class="force-wrap" aria-hidden="true" data-force-wrap>
    <canvas id="a-force" class="force-wrap__canvas"></canvas>
    <div class="force-wrap__shade"></div>
  </div>

  <main id="top">
    <section class="sec" data-sec="hero" style="--h: 150vh">
      <div class="sticky">
        <div class="panel panel--hero" data-hero>
          <p class="eyebrow">Autonomy for contested environments</p>
          <h1 class="display">Deterrence<br /><em>through autonomy.</em></h1>
          <p class="lede">{site.description}</p>
          <p class="hint mono"><span class="hint__lens"></span>Move to see what the machine sees</p>
        </div>
      </div>
    </section>

    <section class="sec" data-sec="shift" style="--h: 170vh">
      <div class="sticky">
        <div class="panel panel--left" data-fade>
          <p class="eyebrow">01 — The shift</p>
          <h2 class="headline">Conflict is becoming autonomous.</h2>
          <p class="lede">Unmanned systems now shape the battlefield. Advantage goes to machines that can keep acting when links fail and no one can intervene.</p>
        </div>
      </div>
    </section>

    <section class="sec" data-sec="world" style="--h: 240vh">
      <div class="sticky">
        <div class="panel panel--left" data-fade>
          <p class="eyebrow">02 — A different world</p>
          <h2 class="headline">Most autonomy expects a tidy world.</h2>
          <div class="versus">
            <div>
              <p class="eyebrow">Built for</p>
              <ul><li>Roads and warehouses</li><li>Known maps</li><li>Reliable GPS</li><li>Predictable conditions</li></ul>
            </div>
            <div>
              <p class="eyebrow eyebrow--accent">Needed for</p>
              <ul><li>Unstructured terrain</li><li>No map at all</li><li>Denied navigation</li><li>An adversary</li></ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sec" data-sec="reason" style="--h: 620vh">
      <div class="sticky">
        <div class="reason" data-fade>
          <h2 class="headline reason__title">It doesn't just map the world.<br /><em>It reasons about what it doesn't know.</em></h2>
          <ol class="rail" data-rail>
            <span class="rail__bar"><span class="rail__fill" data-rail-fill></span></span>
            {stages.map((s, i) => (
              <li data-stage={i}>
                <span class="rail__k mono">{String(i + 1).padStart(2, '0')} {s.k}</span>
                <span class="rail__h">{s.h}</span>
                <span class="rail__p">{s.p}</span>
                {s.k === 'Risk' && (
                  <span class="rail__p rail__legend mono">
                    <span><i style="--c: #ffa829"></i>Terrain</span>
                    <span><i style="--c: #9e73ff"></i>Ambiguous sensing</span>
                    <span><i style="--c: #ff3829"></i>Electronic warfare</span>
                  </span>
                )}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="sec" data-sec="link" style="--h: 260vh">
      <div class="sticky">
        <div class="panel panel--left" data-fade>
          <p class="eyebrow">03 — Connected</p>
          <h2 class="headline">It arrives.<br /><em>And it isn't alone.</em></h2>
          <p class="lede">What one machine learns becomes part of a shared picture of the mission.</p>
        </div>
      </div>
    </section>

    <section class="force" data-sec="force" style="--h: 640vh">
      <div class="force__sticky">
        <div class="force__caps">
          {forceCaps.map((c, i) => (
            <div class="force__cap" data-fcap={i}>
              <p class="eyebrow">{c.e}</p>
              <h2 class="headline">{c.h}</h2>
              <p class="lede">{c.p}</p>
            </div>
          ))}
        </div>
        <div class="force__hud mono" aria-hidden="true">
          <div class="force__counts">
            <span><b data-n="machines">1</b> machines</span>
            <span><b data-n="operators">0</b> operators</span>
            <span><b data-n="teams">1</b> teams</span>
          </div>
          <div class="force__scale"><i data-bar></i><span data-km>—</span></div>
        </div>
      </div>
    </section>

    <section class="sec" data-sec="deter" style="--h: 320vh">
      <div class="sticky deter__sticky">
        <div class="deter">
          <p class="eyebrow">08 — Why it matters</p>
          <ol class="deter__steps">
            {deterSteps.map((d, i) => (
              <li data-step={i}>
                <span class="deter__n mono">{String(i + 1).padStart(2, '0')}</span>
                <div class="deter__copy">
                  <h2 class="headline">{d.h}</h2>
                  <p class="lede">{d.p}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="deep" data-sec="deep" data-tab="air" style="--h: 680vh">
      <div class="deep__sticky">
        <canvas id="a-deep" class="deep__gl" aria-label="The machine's camera view of a dark passage beside the 2.5D risk map it builds while driving" role="img"></canvas>
        <canvas id="a-deep-2d" class="deep__gl" hidden></canvas>
        <canvas id="a-air" class="deep__gl" aria-label="Chase view of a fixed-wing machine flying a canyon beside its risk map" role="img" hidden></canvas>
        <div class="deep__shade" aria-hidden="true"></div>
        <p class="deep__tag deep__tag--r mono">Belief · risk map</p>
        <p class="deep__route deep__route--direct mono" data-route="direct" aria-hidden="true">Direct · <b data-len="direct">–</b> m · drop · high risk</p>
        <p class="deep__air deep__route--direct mono" data-air="radar" aria-hidden="true">EW · radar detected</p>
        <p class="deep__air deep__route--direct mono" data-air="planned" aria-hidden="true">Planned · exposed · high risk</p>
        <p class="deep__air deep__route--detour mono" data-air="detour" aria-hidden="true">Re-plan · terrain-masked</p>
        <p class="deep__route deep__route--detour mono" data-route="detour" aria-hidden="true">Detour · <b data-len="detour">–</b> m · low risk</p>
        <div class="deep__switch mono" role="tablist" aria-label="Fieldcore OS demos">
          <span class="deep__badge">In progress</span>
          <button type="button" role="tab" data-tab="air" aria-selected="true">Air · fixed-wing</button>
          <button type="button" role="tab" data-tab="ground" aria-selected="false">Ground · underground</button>
        </div>
        <div class="deep__copy">
          <p class="eyebrow">09 — Fieldcore OS</p>
          {[['ground', beats], ['air', airBeats]].map(([k, list]) => (
            <ol class="deep__beats" data-beats={k as string} hidden={k === 'ground'}>
              {(list as typeof beats).map((b, i) => (
                <li data-beat={i}>
                  <h2 class="headline">{b.h}</h2>
                  <p class="lede">{b.p}</p>
                </li>
              ))}
            </ol>
          ))}
        </div>
        <div class="deep__hud mono">
          <span><b data-hud="dist">0</b> m travelled</span>
          <span><b data-hud="mapped">0</b>% of passage mapped</span>
          <span><b data-hud="unc">–</b> mean uncertainty</span>
        </div>
        <div class="deep__legend mono" aria-hidden="true">
          <span class="deep__ramp"></span><span>Low → high risk</span>
          <span class="deep__unk"></span><span>Not yet observed</span>
        </div>
      </div>
    </section>

    <section class="sec" data-sec="close" id="contact" style="--h: 130vh">
      <div class="sticky">
        <div class="panel panel--center" data-fade>
          <h2 class="display">Deterrence<br /><em>through autonomy.</em></h2>
          <p class="lede">Building the autonomy layer for machines operating where the world is uncertain.</p>
          <div class="ctas">
            <a class="btn" href={`mailto:${site.contactEmail}?subject=Partnership`}>Partner with us</a>
            <a class="btn btn--ghost" href={`mailto:${site.contactEmail}?subject=Careers`}>Build with us</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <div class="foot"><SiteFooter /></div>
</Base>

<script>
  import { initMotion, hasWebGL, prefersReducedMotion, range, smooth, clamp, whenNear, visibleLoop, fitCanvas } from '../lib/motion';
  import type { SceneState } from '../components/candidate-a/sceneA';
  import { A_EXTENT, A_GOAL, A_HUB, A_LINK_DIST, A_WORLD } from '../components/candidate-a/worldA';

  const { gsap } = initMotion();
  const reduced = prefersReducedMotion();
  type Key = { sec: string; at: number; s: Partial<SceneState> };

  /* Scene keyframes anchored to section scroll progress (0 = section top at viewport top). */
  const KEYS: Key[] = [
    { sec: 'hero', at: 0, s: { relief: 1, structured: 0, belief: 0, points: 0, risk: 0, field: 0, plans: 0, lens: 1, known: 0, profile: 0, team: 0, others: 0, dist: 3.4, elev: 0.36, azim: 0.9, focus: 0, dim: 0, comm: 0, bev: 0 } },
    { sec: 'hero', at: 0.6, s: { lens: 1, dist: 3.8 } },
    { sec: 'shift', at: 0, s: { lens: 0, dist: 4.2, elev: 0.42, azim: 1.5 } },
    { sec: 'shift', at: 0.8, s: { dist: 5.2, elev: 0.62 } },
    { sec: 'world', at: 0, s: { structured: 1, relief: 0.03, dist: 6, elev: 0.85, azim: 1.7 } },
    { sec: 'world', at: 0.25, s: { structured: 1, relief: 0.03 } },
    { sec: 'world', at: 0.85, s: { structured: 0, relief: 1, dist: 4.4, elev: 0.55, azim: 1.9 } },
    { sec: 'reason', at: 0, s: { belief: 0, points: 0, dim: 0, dist: 3.1, elev: 0.5, azim: 2.1 } },
    { sec: 'reason', at: 0.14, s: { points: 0, dim: 0 } },
    { sec: 'reason', at: 0.26, s: { points: 1, dim: 0.8, dist: 2.7 } },
    { sec: 'reason', at: 0.36, s: { belief: 0 } },
    { sec: 'reason', at: 0.48, s: { belief: 1, known: 0.15, points: 0.35, dim: 0.8, dist: 3.4, elev: 0.62 } },
    { sec: 'reason', at: 0.56, s: { risk: 0, field: 0 } },
    { sec: 'reason', at: 0.68, s: { risk: 1, field: 1, points: 0, known: 0.3, elev: 0.66 } },
    { sec: 'reason', at: 0.76, s: { plans: 0 } },
    { sec: 'reason', at: 0.88, s: { plans: 1, dist: 3, elev: 0.6, azim: 2.4 } },
    { sec: 'link', at: 0, s: { comm: 0 } },
    { sec: 'link', at: 0.22, s: { plans: 0, field: 0, risk: 0, points: 0, belief: 0, dim: 0, dist: 3.2, elev: 0.75 } },
    { sec: 'link', at: 0.4, s: { comm: 1 } },
    { sec: 'link', at: 0.72, s: { bev: 1, dist: A_LINK_DIST, elev: 1.5, azim: Math.PI / 2 } },
    { sec: 'force', at: 0.1, s: {} },
    { sec: 'close', at: 0, s: { comm: 0, bev: 0, known: 0, team: 0, others: 0, focus: 0, belief: 0, risk: 0, plans: 0, points: 0, dim: 0, lens: 1, dist: 3, elev: 0.22, azim: 5.2 } },
  ];

  const sections = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-sec]').forEach((el) => sections.set(el.dataset.sec!, el));

  let anchors: { y: number; s: SceneState }[] = [];
  /* The lead vehicle's progress to its goal is tied linearly to scroll, from the top of the
     page to the moment it stops in "Connected", so it never has to rush to catch up. */
  let driveEnd = 1;
  const driveAt = (y: number) => clamp(y / driveEnd);
  function layoutKeys() {
    const vh = window.innerHeight;
    const link = sections.get('link')!;
    driveEnd = Math.max(1, link.getBoundingClientRect().top + window.scrollY + 0.22 * Math.max(0, link.offsetHeight - vh));
    let acc = { ...KEYS[0].s } as SceneState;
    anchors = KEYS.map((k) => {
      const el = sections.get(k.sec)!;
      const top = el.getBoundingClientRect().top + window.scrollY;
      const span = Math.max(0, el.offsetHeight - vh);
      acc = { ...acc, ...k.s };
      return { y: top + k.at * span, s: acc };
    });
  }

  function stateAt(y: number): SceneState {
    return { ...keyState(y), drive: driveAt(y) };
  }

  function keyState(y: number): SceneState {
    if (y <= anchors[0].y) return anchors[0].s;
    for (let i = 1; i < anchors.length; i++) {
      const a = anchors[i - 1];
      const b = anchors[i];
      if (y <= b.y) {
        const t = smooth(range(y, a.y, b.y));
        const out = {} as SceneState;
        for (const key in b.s) {
          const k = key as keyof SceneState;
          out[k] = a.s[k] + (b.s[k] - a.s[k]) * t;
        }
        return out;
      }
    }
    return anchors[anchors.length - 1].s;
  }

  /* Text panels fade in/out as each sticky section passes. */
  document.querySelectorAll<HTMLElement>('[data-fade]').forEach((panel) => {
    const sec = panel.closest('[data-sec]') as HTMLElement;
    gsap.timeline({ scrollTrigger: { trigger: sec, start: 'top 75%', end: 'bottom 25%', scrub: reduced ? true : 0.6 } })
      .fromTo(panel, { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, duration: 1, ease: 'power2.out' })
      .to(panel, { autoAlpha: 1, duration: 3 })
      .to(panel, { autoAlpha: 0, y: -40, duration: 1, ease: 'power2.in' });
  });
  gsap.to('[data-hero]', {
    autoAlpha: 0, y: -60,
    scrollTrigger: { trigger: sections.get('hero'), start: 'top top', end: 'bottom 40%', scrub: 0.6 },
  });

  /* Section-local UI driven from scroll position. */
  const rail = document.querySelector<HTMLElement>('[data-rail]')!;
  const railItems = [...rail.querySelectorAll<HTMLElement>('[data-stage]')];
  const railFill = document.querySelector<HTMLElement>('[data-rail-fill]')!;
  const coverers = [sections.get('deep')!];
  let forceOpacity = 0;
  const STAGE_AT = [0, 0.2, 0.4, 0.6, 0.8];

  function sectionProgress(name: string) {
    const el = sections.get(name)!;
    const r = el.getBoundingClientRect();
    return clamp(-r.top / Math.max(1, el.offsetHeight - window.innerHeight));
  }

  function updateUI(_s: SceneState) {
    const p = sectionProgress('reason');
    let active = 0;
    STAGE_AT.forEach((a, i) => p >= a && (active = i));
    railItems.forEach((li, i) => li.classList.toggle('is-active', i === active));
    railItems.forEach((li, i) => li.classList.toggle('is-past', i < active));
    railFill.style.transform = `scaleY(${p})`;
  }

  /* Bird's-eye chapter: a fixed Canvas 2D layer that takes over from the 3D view
     once its camera is looking straight down on the stopped vehicle. */
  const forceSec = sections.get('force')!;
  const forceWrap = document.querySelector<HTMLElement>('[data-force-wrap]')!;
  const forceCanvas = document.getElementById('a-force') as HTMLCanvasElement;
  const forceCaps = [...forceSec.querySelectorAll<HTMLElement>('[data-fcap]')];
  const deepEl = sections.get('deep')!;
  function updateForceFade() {
    const live = deepEl.getBoundingClientRect().top > 0;
    forceOpacity = live ? smooth(range(sectionProgress('link'), 0.74, 0.96)) : 0;
    forceWrap.style.opacity = String(forceOpacity);
    forceWrap.style.visibility = forceOpacity > 0.001 ? 'visible' : 'hidden';
  }
  updateForceFade();
  window.addEventListener('scroll', updateForceFade, { passive: true });

  /* A connected argument: keep earlier steps visible as the next one takes focus. */
  const deterSteps = [...sections.get('deter')!.querySelectorAll<HTMLElement>('[data-step]')];
  const updateDeter = () => {
    const p = sectionProgress('deter');
    const active = Math.min(deterSteps.length - 1, Math.floor(p * deterSteps.length));
    deterSteps.forEach((el, i) => {
      el.classList.toggle('is-on', i <= active);
      el.classList.toggle('is-current', i === active);
      if (i === active) el.setAttribute('aria-current', 'step');
      else el.removeAttribute('aria-current');
    });
  };
  updateDeter();
  window.addEventListener('scroll', updateDeter, { passive: true });
  window.addEventListener('resize', updateDeter);
  whenNear(sections.get('link')!, async () => {
    const [{ ForceScene, forceStage, stateAt: forceAt }, { createWorld }] = await Promise.all([
      import('../components/candidate-c/sceneC'),
      import('../lib/world'),
    ]);
    const lowPower = window.innerWidth < 760 || (navigator.hardwareConcurrency ?? 8) <= 4;
    const fov = ((window.innerWidth < 700 ? 55 : 42) * Math.PI) / 180;
    const z0 = (2 * A_LINK_DIST * Math.tan(fov / 2)) / A_EXTENT;
    const stages = [
      forceStage({ z: z0, uplink: 1, move: 0 }),
      forceStage({ z: 0.42, follow: 0.5, uplink: 1, others: 1, fog: 0.35, threats: 0.3 }),
      forceStage({ z: 0.72, cx: 0.62, cy: 0.4, follow: 0, uplink: 1, others: 1, team: 1, fog: 0.55, threats: 0.4, risk: 0.15 }),
      forceStage({ z: 0.86, cx: 0.58, cy: 0.44, follow: 0, uplink: 1, others: 1, team: 1, operator: 1, fog: 0.55, threats: 0.4, risk: 0.12 }),
      forceStage({ z: 1.08, cx: 0.5, cy: 0.5, follow: 0, uplink: 1, others: 1, team: 1, operator: 1, network: 1, fog: 0.45, threats: 0.35, risk: 0.1 }),
    ];
    const N = stages.length - 1;
    const HOLD = 0.5;
    const scene = new ForceScene(forceCanvas, {
      lowPower,
      softEdges: true,
      world: createWorld(A_WORLD),
      start: { ...A_GOAL, heading: -0.6 },
      hub: A_HUB,
      teams: [{ u: 0.28, v: 0.28 }, { u: 0.5, v: 0.8 }],
      operators: [{ u: 0.16, v: 0.16 }, { u: 0.32, v: 0.9 }],
    });
    scene.resize();
    window.addEventListener('resize', () => scene.resize());
    await scene.build(lowPower);
    forceCanvas.classList.add('is-ready');
    const bar = forceSec.querySelector<HTMLElement>('[data-bar]')!;
    const km = forceSec.querySelector<HTMLElement>('[data-km]')!;
    const nEls = Object.fromEntries([...forceSec.querySelectorAll<HTMLElement>('[data-n]')].map((el) => [el.dataset.n!, el]));
    const nice = [0.05, 0.1, 0.2, 0.5, 1, 2, 5, 10, 20];
    let shown = 0;
    let hudTick = 0;
    visibleLoop(forceCanvas, (_t, dt) => {
      if (forceOpacity < 0.001) return;
      const f = Math.min(N, sectionProgress('force') * (N + HOLD));
      shown = reduced ? f : shown + (f - shown) * Math.min(1, dt * 6);
      const st = forceAt(shown, stages);
      if (st.move < 0.01 && eyes) scene.setHero(eyes.mainPose());
      scene.frame(dt, st);
      const idx = Math.round(shown) - 1;
      forceCaps.forEach((el, i) => el.classList.toggle('is-on', i === idx));
      if (hudTick++ % 6) return;
      const kpp = scene.kmPerPx(st);
      const len = nice.find((n) => n / kpp > 70) ?? 20;
      bar.style.width = `${(len / kpp).toFixed(0)}px`;
      km.textContent = len < 1 ? `${len * 1000} m` : `${len} km`;
      const c = scene.counts(st);
      for (const key of ['machines', 'operators', 'teams'] as const) nEls[key].textContent = String(c[key]);
    });
  }, '600px');

  /* Underground chapter: its own canvas, booted when the section approaches. */
  const deepSec = sections.get('deep')!;
  whenNear(deepSec, async () => {
    const { createPassage, passageStats } = await import('../lib/passage');
    const lowPower = window.innerWidth < 760 || (navigator.hardwareConcurrency ?? 8) <= 4;
    const P = createPassage({ res: lowPower ? 160 : 224 });
    let tab: 'ground' | 'air' = 'air';
    const beatLists = Object.fromEntries(
      [...deepSec.querySelectorAll<HTMLElement>('[data-beats]')].map((ol) => [ol.dataset.beats!, ol]),
    );
    const beatsNow = () => [...beatLists[tab].querySelectorAll<HTMLElement>('[data-beat]')];
    const hud = (k: string) => deepSec.querySelector<HTMLElement>(`[data-hud="${k}"]`)!;
    const [hDist, hMapped, hUnc] = [hud('dist'), hud('mapped'), hud('unc')];
    const sJ = P.junction;
    const sEnd = P.length - 0.05;
    const routeEls = {
      direct: deepSec.querySelector<HTMLElement>('[data-route="direct"]')!,
      detour: deepSec.querySelector<HTMLElement>('[data-route="detour"]')!,
    };
    deepSec.querySelector('[data-len="direct"]')!.textContent = P.directLen.toFixed(0);
    deepSec.querySelector('[data-len="detour"]')!.textContent = P.detourLen.toFixed(0);
    /* drive to the fork, hold while it weighs both branches, then take the detour */
    /* to the fork, a few metres down the direct branch, hold while the drop resolves,
       reverse out, then the detour */
    const target = () => {
      const p = sectionProgress('deep');
      if (p < 0.2) return 2 + range(p, 0.03, 0.2) * (sJ - 2);
      if (p < 0.32) return sJ + smooth(range(p, 0.2, 0.32)) * (P.probe - sJ);
      if (p < 0.44) return P.probe;
      if (p < 0.54) return P.probe + smooth(range(p, 0.44, 0.54)) * (P.back - P.probe);
      return P.back + range(p, 0.54, 0.95) * (sEnd - P.back);
    };
    const viewAt = () => {
      const p = sectionProgress('deep');
      return { look: 0, compare: smooth(range(p, 0.33, 0.38)), decided: smooth(range(p, 0.41, 0.45)) };
    };
    let s = target();
    let lastStat = -1;
    const routes = (v: { compare: number; decided: number }, at?: { direct: readonly [number, number]; detour: readonly [number, number] }) => {
      for (const k of ['direct', 'detour'] as const) {
        const el = routeEls[k];
        el.classList.toggle('is-on', v.compare > 0.5);
        el.classList.toggle('is-chosen', k === 'detour' && v.decided > 0.5);
        el.classList.toggle('is-rejected', k === 'direct' && v.decided > 0.5);
        if (at) el.style.transform = `translate(${at[k][0].toFixed(0)}px, ${at[k][1].toFixed(0)}px)`;
      }
    };
    const ui = (now: number) => {
      const beatEls = beatsNow();
      const bi = Math.min(beatEls.length - 1, Math.floor(sectionProgress('deep') * beatEls.length));
      beatEls.forEach((el, i) => el.classList.toggle('is-active', i === bi));
      if (now - lastStat < 0.2) return;
      lastStat = now;
      const st = passageStats(P, s);
      hDist.textContent = s.toFixed(1);
      hMapped.textContent = String(Math.round(st.mapped * 100));
      hUnc.textContent = st.meanUnc.toFixed(2);
    };
    const step = (dt: number) => (s += (target() - s) * (reduced ? 1 : 1 - Math.exp(-dt * 5)));

    const gl = document.getElementById('a-deep') as HTMLCanvasElement;
    if (hasWebGL()) {
      const { DeepScene } = await import('../components/candidate-a/deepScene');
      const scene = new DeepScene(gl, P, { lowPower });
      scene.resize();
      window.addEventListener('resize', () => scene.resize());
      gl.classList.add('is-ready');

      /* Air tab: a second scene on its own canvas, created on first use */
      const airCanvas = document.getElementById('a-air') as HTMLCanvasElement;
      const airEls = Object.fromEntries(
        [...deepSec.querySelectorAll<HTMLElement>('[data-air]')].map((el) => [el.dataset.air!, el]),
      ) as Record<'radar' | 'planned' | 'detour', HTMLElement>;
      const tabs = [...deepSec.querySelectorAll<HTMLButtonElement>('[data-tab]')];
      let air: import('../components/candidate-a/airScene').AirScene | null = null;
      let sa = 0;
      const airTarget = () => range(sectionProgress('deep'), 0.03, 0.95);
      const airView = () => {
        const p = sectionProgress('deep');
        return { detect: smooth(range(p, 0.27, 0.34)), decided: smooth(range(p, 0.42, 0.49)) };
      };
      const setTab = async (t: 'ground' | 'air', restart = false) => {
        if (restart && t !== tab) {
          window.scrollTo({ top: deepSec.getBoundingClientRect().top + window.scrollY + 2, behavior: 'auto' });
          s = target();
        }
        tab = t;
        deepSec.dataset.tab = t;
        tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === t)));
        Object.entries(beatLists).forEach(([k, ol]) => (ol.hidden = k !== t));
        if (t === 'air' && !air) {
          const { AirScene } = await import('../components/candidate-a/airScene');
          air = new AirScene(airCanvas, { lowPower });
          window.addEventListener('resize', () => air?.resize());
        }
        if (restart || t === 'air') sa = airTarget();
        airCanvas.hidden = t !== 'air';
        gl.hidden = t === 'air';
        if (t === 'air') {
          air!.resize();
          airCanvas.classList.add('is-ready');
        }
      };
      tabs.forEach((b) => b.addEventListener('click', () => setTab(b.dataset.tab as 'ground' | 'air', true)));
      setTab('air');

      visibleLoop(deepSec, (t, dt) => {
        if (tab === 'air' && air) {
          sa += (airTarget() - sa) * (reduced ? 1 : 1 - Math.exp(-dt * 5));
          const v = airView();
          air.frame(dt, sa, v);
          const at = air.anchors();
          for (const k of ['radar', 'planned', 'detour'] as const) {
            const el = airEls[k];
            el.classList.toggle('is-on', v.detect > 0.5 && (k !== 'detour' || v.decided > 0.2));
            el.classList.toggle('is-rejected', k === 'planned' && v.decided > 0.5);
            el.classList.toggle('is-chosen', k === 'detour' && v.decided > 0.5);
            el.style.transform = `translate(${at[k][0].toFixed(0)}px, ${at[k][1].toFixed(0)}px)`;
          }
          ui(t);
          return;
        }
        step(dt);
        const v = viewAt();
        scene.frame(dt, s, v);
        routes(v, scene.anchors());
        ui(t);
      });
    } else {
      const { PassageMap2D } = await import('../lib/passageMap2d');
      const flat = document.getElementById('a-deep-2d') as HTMLCanvasElement;
      gl.hidden = true;
      flat.hidden = false;
      deepSec.classList.add('is-flat');
      tab = 'ground';
      deepSec.dataset.tab = 'ground';
      Object.entries(beatLists).forEach(([k, ol]) => (ol.hidden = k !== 'ground'));
      const view = new PassageMap2D(flat, P);
      flat.classList.add('is-ready');
      visibleLoop(deepSec, (t, dt) => {
        fitCanvas(flat, 1.5);
        step(dt);
        const v = viewAt();
        view.draw(s, t, v.compare);
        routes(v);
        ui(t);
      });
    }
  }, '900px');

  /* Scene boot: lazy so hero text paints first. */
  const canvas = document.getElementById('a-gl') as HTMLCanvasElement;
  const fallback = document.getElementById('a-fallback') as HTMLCanvasElement;

  let eyes: { mainPose(): { u: number; v: number; heading: number } } | null = null;
  async function boot() {
    layoutKeys();
    window.addEventListener('resize', layoutKeys);
    const ro = new ResizeObserver(layoutKeys);
    ro.observe(document.body);

    if (!hasWebGL()) {
      canvas.hidden = true;
      fallback.hidden = false;
      const [{ SimView }, { createWorld }, { fitCanvas, visibleLoop }] = await Promise.all([
        import('../lib/simView'),
        import('../lib/world'),
        import('../lib/motion'),
      ]);
      fitCanvas(fallback, 1);
      const view = new SimView(fallback, createWorld({ size: 128, seed: 11 }), 'belief', 30);
      fallback.classList.add('is-ready');
      visibleLoop(fallback, (t) => {
        fitCanvas(fallback, 1);
        view.draw(t);
        updateUI(stateAt(window.scrollY));
      });
      return;
    }

    const { EyesScene } = await import('../components/candidate-a/sceneA');
    const lowPower = window.innerWidth < 760 || (navigator.hardwareConcurrency ?? 8) <= 4;
    const scene = new EyesScene(canvas, { lowPower });
    eyes = scene;
    scene.resize();
    window.addEventListener('resize', () => scene.resize());
    window.addEventListener('pointermove', (e) => scene.setPointer(e.clientX, e.clientY), { passive: true });

    let cur = stateAt(window.scrollY);
    let last = performance.now();
    let first = true;
    const tick = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      const target = stateAt(window.scrollY);
      const k = reduced ? 1 : 1 - Math.exp(-dt * 6);
      for (const key in target) {
        const kk = key as keyof SceneState;
        cur[kk] += (target[kk] - cur[kk]) * k;
      }
      updateUI(cur);
      const covered = forceOpacity > 0.999 || coverers.some((el) => {
        const r = el.getBoundingClientRect();
        return r.top <= 0 && r.bottom >= window.innerHeight;
      });
      if (!covered && !document.hidden) {
        scene.frame(dt, cur);
        if (first) {
          canvas.classList.add('is-ready');
          first = false;
        }
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  if ('requestIdleCallback' in window) requestIdleCallback(() => boot(), { timeout: 300 });
  else setTimeout(boot, 50);
</script>

