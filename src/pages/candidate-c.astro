---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/shared/SiteNav.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import ProofReel from '../components/shared/ProofReel.astro';
import { site } from '../config/site';

const caps = [
  { e: 'Autonomy for contested environments', h: 'Deterrence through autonomy.', p: site.description, hero: true },
  { e: '01 — The shift', h: 'Autonomy is becoming strategic infrastructure.', p: 'The machines that shape deterrence will have to see, decide and act where people can’t — or shouldn’t — be.' },
  { e: '02 — A different world', h: 'Unmapped. Denied. Adversarial.', p: 'Civilian autonomy assumes maps, GNSS and a world that cooperates. Defense autonomy gets none of these.' },
  { e: '03 — Reasoning under uncertainty', h: 'It plans around what it doesn’t know.', p: 'Unobserved ground is priced as risk, not treated as free space. Every candidate path is scored before one is chosen.' },
  { e: '04 — The Autonomy Engine', h: 'Perceive. Believe. Assess. Plan. Act.', p: 'One embodiment‑independent loop: localisation, world belief, risk estimation, planning, control and safety.' },
  { e: '05 — Multi‑embodiment', h: 'Same engine. Different bodies.', p: 'Ground, air, legged and maritime machines share the reasoning. Each brings its own dynamics — and its own idea of risk.' },
  { e: '06 — Autonomous teams', h: 'Machines that share what they know.', p: 'One belief, built together. Tasks distributed by capability, not by platform.' },
  { e: '07 — Human–machine teaming', h: 'Humans set intent. Machines carry it out.', p: 'Operators supervise many machines at once and stay in command of the decisions that matter.' },
  { e: '08 — Orchestration OS', h: 'From one machine to a force.', p: 'Mission intent decomposed across teams, machines and operators — and re-planned continuously as the situation changes.' },
];
const rail = ['Machine', 'Shift', 'Contested', 'Uncertainty', 'Engine', 'Embodiments', 'Team', 'Human + machine', 'Force'];
---

<Base theme="c" title="From One Machine to a Force">
  <SiteNav />
  <main>
    <section class="zoom" data-zoom>
      <div class="zoom__stage">
        <canvas class="zoom__canvas" data-canvas aria-hidden="true"></canvas>
        <div class="zoom__shade" aria-hidden="true"></div>

        <div class="zoom__caps">
          {caps.map((c, i) => (
            <div class:list={['cap', { 'cap--hero': c.hero, 'is-on': i === 0 }]} data-cap>
              <p class="eyebrow">{c.e}</p>
              {c.hero ? <h1 class="display">{c.h}</h1> : <h2 class="headline">{c.h}</h2>}
              <p class="lede">{c.p}</p>
            </div>
          ))}
        </div>

        <ol class="rail mono" aria-hidden="true">
          {rail.map((r, i) => <li class:list={{ 'is-on': i === 0 }} data-rail>{r}</li>)}
        </ol>

        <div class="hud mono" aria-hidden="true">
          <div class="hud__counts">
            <span><b data-n="machines">1</b> machines</span>
            <span><b data-n="operators">0</b> operators</span>
            <span><b data-n="teams">1</b> teams</span>
          </div>
          <div class="hud__scale"><i data-bar></i><span data-km>—</span></div>
        </div>
        <p class="scroll-hint mono" data-hint>Scroll to zoom out</p>
      </div>
    </section>

    <section class="after">
      <p class="eyebrow">In development</p>
      <h2 class="headline">The engine, running today.</h2>
      <p class="lede">Simulation output from our stack. Placeholder renders until field footage replaces them.</p>
      <ProofReel layout="log" />
    </section>

    <section class="after after--close" id="contact">
      <h2 class="display">Deterrence through autonomy.</h2>
      <p class="lede">Building the autonomy layer for machines — and forces — that must operate where the world won’t cooperate.</p>
      <div class="cta">
        <a class="btn" href={`mailto:${site.contactEmail}?subject=Partnership`}>Partner with us</a>
        <a class="btn btn--ghost" href={`mailto:${site.contactEmail}?subject=Careers`}>Build with us</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<script>
  import { initMotion, prefersReducedMotion, visibleLoop } from '../lib/motion';
  import { ForceScene, STAGES, stateAt } from '../components/candidate-c/sceneC';

  const { gsap, ScrollTrigger } = initMotion();
  const root = document.querySelector<HTMLElement>('[data-zoom]')!;
  const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
  const caps = [...root.querySelectorAll<HTMLElement>('[data-cap]')];
  const rail = [...root.querySelectorAll<HTMLElement>('[data-rail]')];
  const hint = root.querySelector<HTMLElement>('[data-hint]')!;
  const bar = root.querySelector<HTMLElement>('[data-bar]')!;
  const km = root.querySelector<HTMLElement>('[data-km]')!;
  const nEls = Object.fromEntries([...root.querySelectorAll<HTMLElement>('[data-n]')].map((el) => [el.dataset.n!, el]));
  const N = STAGES.length - 1;
  const HOLD = 0.6;
  let f = 0;
  let active = 0;

  ScrollTrigger.create({
    trigger: root,
    start: 'top top',
    end: () => `+=${window.innerHeight * (N + HOLD) * 1.1}`,
    pin: '.zoom__stage',
    scrub: true,
    onUpdate: (st) => {
      f = Math.min(N, st.progress * (N + HOLD));
      const idx = Math.min(N, Math.round(f));
      hint.style.opacity = f > 0.15 ? '0' : '';
      if (idx === active) return;
      caps[active].classList.remove('is-on');
      rail[active].classList.remove('is-on');
      caps[idx].classList.add('is-on');
      rail[idx].classList.add('is-on');
      active = idx;
    },
  });

  gsap.utils.toArray<HTMLElement>('.after').forEach((el) => {
    gsap.from(el.children, { y: 24, opacity: 0, duration: 0.9, stagger: 0.08, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 80%' } });
  });

  const nice = [0.05, 0.1, 0.2, 0.5, 1, 2, 5, 10, 20];
  const lowPower = window.innerWidth < 760 || (navigator.hardwareConcurrency ?? 8) <= 4;
  const scene = new ForceScene(canvas, { lowPower });
  scene.resize();
  window.addEventListener('resize', () => scene.resize());
  let shown = f;
  const speed = prefersReducedMotion() ? 0.25 : 1;

  requestAnimationFrame(() => setTimeout(async () => {
    await scene.build(lowPower);
    canvas.classList.add('is-ready');
    let hudTick = 0;
    visibleLoop(root, (_t, dt) => {
      shown += (f - shown) * Math.min(1, dt * 6);
      const s = stateAt(shown);
      scene.frame(dt * speed, s);
      if (hudTick++ % 6) return;
      const kpp = scene.kmPerPx(s);
      const len = nice.find((n) => n / kpp > 70) ?? 20;
      bar.style.width = `${(len / kpp).toFixed(0)}px`;
      km.textContent = len < 1 ? `${len * 1000} m` : `${len} km`;
      const c = scene.counts(s);
      for (const key of ['machines', 'operators', 'teams'] as const) nEls[key].textContent = String(c[key]);
    });
  }, 30));
</script>

<style>
  .zoom__stage { position: relative; height: 100svh; overflow: hidden; background: #080a0b; }
  .zoom__canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.4s var(--ease); }
  .zoom__canvas.is-ready { opacity: 1; }
  .zoom__shade {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(8, 10, 11, 0.88) 0%, rgba(8, 10, 11, 0.55) 30%, rgba(8, 10, 11, 0) 55%),
      radial-gradient(ellipse at 60% 50%, transparent 55%, rgba(8, 10, 11, 0.7) 100%);
  }
  .zoom__caps { position: absolute; left: var(--pad); top: 0; bottom: 0; width: min(520px, 42vw); }
  .cap {
    position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center;
    opacity: 0; transform: translateY(16px); transition: opacity 0.5s var(--ease), transform 0.6s var(--ease); pointer-events: none;
  }
  .cap.is-on { opacity: 1; transform: none; pointer-events: auto; }
  .cap .headline { font-size: clamp(2rem, 3.4vw, 3.3rem); letter-spacing: -0.03em; line-height: 1.02; margin: 0.4em 0 0.55em; max-width: 13ch; }
  .cap .lede { max-width: 38ch; }
  .cap--hero .display { font-size: clamp(3.4rem, 7vw, 7.4rem); line-height: 0.9; letter-spacing: -0.05em; margin: 0.25em 0 0.35em; max-width: 8ch; }
  .rail {
    position: absolute; right: var(--pad); top: 50%; transform: translateY(-50%);
    list-style: none; margin: 0; padding: 0 0 0 16px; border-left: 1px solid var(--line);
    display: grid; gap: 14px; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--fg-faint);
  }
  .rail li { position: relative; transition: color 0.4s; }
  .rail li::before { content: ''; position: absolute; left: -20px; top: 50%; width: 7px; height: 7px; margin-top: -3.5px; border-radius: 50%; background: #080a0b; border: 1px solid var(--fg-faint); transition: background 0.4s, border-color 0.4s; }
  .rail li.is-on { color: var(--fg); }
  .rail li.is-on::before { background: var(--signal); border-color: var(--signal); }
  .hud { position: absolute; right: var(--pad); bottom: 32px; display: grid; gap: 12px; justify-items: end; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--fg-faint); }
  .hud__counts { display: flex; gap: 22px; }
  .hud b { color: var(--fg); font-weight: 500; font-size: 13px; margin-right: 0.4em; }
  .hud__scale { display: flex; align-items: center; gap: 10px; }
  .hud__scale i { display: block; height: 6px; border: 1px solid var(--fg-dim); border-top: 0; transition: width 0.2s; }
  .scroll-hint { position: absolute; left: 50%; bottom: 32px; transform: translateX(-50%); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--fg-faint); transition: opacity 0.4s; }

  .after { padding: 18vh var(--pad); max-width: 1440px; margin: 0 auto; }
  .after .headline { max-width: 16ch; margin: 0.4em 0 0.5em; }
  .after .lede { max-width: 46ch; margin-bottom: 6vh; }
  .after--close { min-height: 80vh; display: flex; flex-direction: column; justify-content: center; }
  .after--close .display { font-size: clamp(3rem, 8vw, 8rem); letter-spacing: -0.05em; line-height: 0.9; max-width: 9ch; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .zoom__shade { background: linear-gradient(180deg, rgba(8, 10, 11, 0.92) 0%, rgba(8, 10, 11, 0.6) 40%, rgba(8, 10, 11, 0) 65%); }
    .zoom__caps { width: auto; right: var(--pad); bottom: auto; height: 46svh; top: 64px; }
    .cap { justify-content: flex-start; }
    .cap .headline { font-size: 1.7rem; }
    .cap .lede { font-size: 0.95rem; }
    .rail { display: none; }
    .hud__counts { gap: 12px; }
  }
</style>
