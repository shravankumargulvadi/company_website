---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/shared/SiteNav.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import ContactDialog from '../components/shared/ContactDialog.astro';
import { site } from '../config/site';

const stages = [
  { k: 'Reality', h: 'The real world isn’t tidy.', p: 'Broken ground, poor visibility, no map, and an adversary working against you.' },
  { k: 'Perception', h: 'Fieldcore OS senses the world in many ways at once.', p: 'Each sensor sees part of the picture, limited by range, light and line of sight.' },
  { k: 'Belief', h: 'It builds its picture of the world.', p: 'What it has seen, how sure it is, and where its knowledge runs out.' },
  { k: 'Risk', h: 'It weighs what could go wrong.', p: 'Terrain, ambiguous sensing, electronic warfare and the unknown, weighed together.' },
  { k: 'Decision', h: 'Then it chooses how to move.', p: 'Many possible paths. One taken, with the consequences understood.' },
];
const beats = [
  { h: 'No GPS. No light. No map.', p: 'Underground, under canopy, inside structures: where remote control fails first.' },
  { h: 'The obvious route.', p: 'Short and straight, so it starts down it. Then, up close, it sees a drop across the floor.' },
  { h: 'It backs out and takes the long way.', p: 'More than twice the distance, at a fraction of the risk. Counterintuitive, and correct.' },
  { h: 'Unknown is not the same as safe.', p: 'It commits only where the evidence supports it, and still completes the mission.' },
];
const airBeats = [
  { h: 'Low, fast, between the cliffs.', p: 'A fixed-wing machine flies the canyon, using the terrain to stay out of sight.' },
  { h: 'An emitter on the planned route.', p: 'It picks up radar ahead. Exposure becomes risk.' },
  { h: 'It changes course.', p: 'The other canyon keeps terrain between it and the radar.' },
  { h: 'Same Fieldcore OS. Different body.', p: 'On the ground or in the air, it weighs terrain, the unknown and the adversary.' },
];
const forestBeats = [
  { h: 'Launch the scout. Hold the UGV.', p: 'A quadrotor takes off from the UGV to scout the forest ahead, detect hazards and find a lower-risk corridor for the ground team.' },
  { h: 'The shortest way is not the safest.', p: 'A narrow passage closes around fallen timber. The alternative crosses a steep drainage cut.' },
  { h: 'Find the corridor. Then scout it.', p: 'The quadrotor checks the eastern route beneath the canopy, building a picture of clearance, terrain and the ground still unseen.' },
  { h: 'Route found. UGV moving.', p: 'The scouted corridor is highlighted and marked low risk. The UGV follows it through the forest, with hazards mapped for the ground team.' },
];
const pilotBeats = [
  { h: 'Limited visibility. Uneven ground.', p: 'A camera beneath the fuselage reveals the landing terrain through haze. The pilot stays in command.' },
  { h: 'Every approach, judged before it’s flown.', p: 'Fieldcore OS checks where each approach would bring the aircraft down and recommends the safest.' },
  { h: 'A safer line into the clearing.', p: 'The lowest-risk approach is highlighted. The alternatives stay visible so the pilot can compare.' },
  { h: 'Guidance, all the way to touchdown.', p: 'The aircraft follows the recommended approach onto a level clearing within the uneven terrain.' },
];
const forceCaps = [
  { e: '04 — Fieldcore OS', h: 'Fieldcore OS. One autonomy, many bodies.', p: 'The autonomy that runs on every machine: ground, air, legged and maritime, each with its own sense of what is risky.', l: [] as string[] },
  { e: '05 — Shunya OS', h: 'Shunya OS. Many machines, one mission.', p: 'The mission intelligence layer above Fieldcore OS.', l: ['Machines share one picture of the world.', 'People set the intent and stay in command.', 'Missions are planned, tasked and re-planned as they unfold.'] },
];
---

<Base theme="a">
  <SiteNav />
  <div class="gl-wrap" aria-hidden="true">
    <canvas id="a-gl" class="gl"></canvas>
    <canvas id="a-fallback" class="gl" hidden></canvas>
    <div class="vignette"></div>
  </div>
  <div class="force-wrap" aria-hidden="true" data-force-wrap>
    <canvas id="a-force" class="force-wrap__canvas"></canvas>
    <div class="force-wrap__shade"></div>
  </div>

  <main id="top">
    <section class="sec" data-sec="hero" style="--h: 150vh">
      <div class="sticky">
        <div class="panel panel--hero" data-hero>
          <h1 class="display">Deterrence<br /><em>through autonomy.</em></h1>
          <p class="lede">Autonomy at scale gives defensive and offensive superiority. An adversary facing both does not start.</p>
          <p class="hint mono"><span class="hint__lens"></span>Scroll to see what we’re building</p>
        </div>
      </div>
    </section>

    <section class="sec" data-sec="shift" style="--h: 170vh">
      <div class="sticky">
        <div class="panel panel--left" data-fade>
          <p class="eyebrow">01 — The shift</p>
          <h2 class="headline">Conflict is becoming autonomous.</h2>
          <p class="lede">Unmanned systems now shape the battlefield. Advantage goes to machines that can keep acting when links fail and no one can intervene.</p>
        </div>
      </div>
    </section>

    <section class="sec" data-sec="world" style="--h: 240vh">
      <div class="sticky">
        <div class="panel panel--left" data-fade>
          <p class="eyebrow">02 — A different world</p>
          <h2 class="headline">Most autonomy expects a tidy world.</h2>
          <div class="versus">
            <div>
              <p class="eyebrow">Built for</p>
              <ul><li>Roads and warehouses</li><li>Known maps</li><li>Reliable GPS</li><li>Predictable conditions</li></ul>
            </div>
            <div>
              <p class="eyebrow eyebrow--accent">Needed for</p>
              <ul><li>Unstructured terrain</li><li>No map at all</li><li>Denied navigation</li><li>An adversary</li></ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sec" data-sec="reason" style="--h: 620vh">
      <div class="sticky">
        <div class="reason" data-fade>
          <h2 class="headline reason__title">
            {stages.map((s, i) => <span class="reason__line" data-stage-title={i} aria-hidden={i === 0 ? undefined : 'true'}>{s.h}</span>)}
          </h2>
          <ol class="rail" data-rail>
            <span class="rail__bar"><span class="rail__fill" data-rail-fill></span></span>
            {stages.map((s, i) => (
              <li data-stage={i}>
                <span class="rail__k mono">{String(i + 1).padStart(2, '0')} {s.k}</span>
                <span class="rail__p">{s.p}</span>
                {s.k === 'Risk' && (
                  <span class="rail__p rail__legend mono">
                    <span><i style="--c: #ffa829"></i>Terrain</span>
                    <span><i style="--c: #9e73ff"></i>Ambiguous sensing</span>
                    <span><i style="--c: #ff3829"></i>Electronic warfare</span>
                  </span>
                )}
              </li>
            ))}
          </ol>
        </div>
        <div class="reason__annotations" data-scene-annotations hidden>
          <svg class="reason__arrows" data-scene-arrows aria-hidden="true">
            <defs><marker id="reason-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0 0 L7 3.5 L0 7" fill="none" stroke="currentColor" stroke-width="1.2" /></marker></defs>
            <path data-scene-arrow="feature" marker-end="url(#reason-arrow)" />
          </svg>
          <div class="reason__callout reason__callout--feature" data-scene-label="feature"><strong data-scene-label-title></strong><span data-scene-label-copy></span></div>
        </div>
      </div>
    </section>

    <section class="sec" data-sec="link" style="--h: 260vh">
      <div class="sticky">
        <div class="panel panel--left" data-fade>
          <p class="eyebrow">03 — Connected</p>
          <h2 class="headline">It arrives.<br /><em>And it isn't alone.</em></h2>
          <p class="lede">What one machine learns becomes part of a shared picture of the mission.</p>
        </div>
      </div>
    </section>

    <section class="force" data-sec="force" style="--h: 380vh">
      <div class="force__sticky">
        <p class="sr-only">On every machine, Fieldcore OS runs one loop: perceive, believe, assess risk, plan, act.</p>
        <div class="force__caps">
          {forceCaps.map((c, i) => (
            <div class="force__cap" data-fcap={i}>
              <p class="eyebrow">{c.e}</p>
              <h2 class="headline">{c.h}</h2>
              <p class="lede">{c.p}</p>
              {c.l.length > 0 && <ul class="force__list">{c.l.map((t) => <li>{t}</li>)}</ul>}
            </div>
          ))}
        </div>
        <div class="force__hud mono" aria-hidden="true">
          <div class="force__counts">
            <span><b data-n="machines">1</b> machines</span>
            <span><b data-n="operators">0</b> operators</span>
            <span><b data-n="teams">1</b> teams</span>
          </div>
          <div class="force__scale"><i data-bar></i><span data-km>—</span></div>
        </div>
      </div>
    </section>


    <section class="deep" data-sec="deep" data-tab="forest" style="--h: 2420vh">
      <div class="deep__sticky">
        <canvas id="a-forest" class="deep__gl" aria-label="A quadrotor launches from a UGV, scouts beneath forest canopy, and marks a low-risk corridor that the UGV then follows" role="img"></canvas>
        <canvas id="a-deep" class="deep__gl" aria-label="The machine's camera view of a dark passage beside the 2.5D risk map it builds while driving" role="img" hidden></canvas>
        <canvas id="a-deep-2d" class="deep__gl" hidden></canvas>
        <canvas id="a-air" class="deep__gl" aria-label="Chase view of a fixed-wing machine flying a canyon beside its risk map" role="img" hidden></canvas>
        <canvas id="a-pilot" class="deep__gl" aria-label="Low-light camera beneath the aircraft near its landing gear, beside a terrain risk map comparing landing approaches" role="img" hidden></canvas>
        <div class="deep__shade" aria-hidden="true"></div>
        <p class="deep__tag deep__tag--r mono">Observed terrain · route assessment</p>
        <p class="deep__route deep__route--direct mono" data-route="direct" aria-hidden="true">Direct · <b data-len="direct">–</b> m · drop · high risk</p>
        <p class="deep__air deep__route--direct mono" data-air="radar" aria-hidden="true">EW · radar detected</p>
        <p class="deep__air deep__route--direct mono" data-air="planned" aria-hidden="true">Planned · exposed · high risk</p>
        <p class="deep__air deep__route--detour mono" data-air="detour" aria-hidden="true">Re-plan · terrain-masked</p>
        <p class="deep__route deep__route--detour mono" data-route="detour" aria-hidden="true">Detour · <b data-len="detour">–</b> m · low risk</p>
        <div class="deep__product" aria-label="Fieldcore OS is in development">
          <h2 class="mono">Fieldcore OS <span class="deep__development">In development</span></h2>
          <p>One autonomy system. Many applications.</p>
        </div>
        <div class="deep__switch mono" role="tablist" aria-label="Applications of Fieldcore OS">
          <span class="deep__badge">Applications</span>
          <button type="button" role="tab" data-tab="forest" aria-selected="true">Scout the route</button>
          <button type="button" role="tab" data-tab="air" aria-selected="false">Stay unseen</button>
          <button type="button" role="tab" data-tab="ground" aria-selected="false">Explore safely</button>
          <button type="button" role="tab" data-tab="pilot" aria-selected="false">Land safely</button>
        </div>
        <div class="deep__recon-cut" aria-hidden="true"><span>Low-risk corridor confirmed</span></div>
        <p class="deep__pilot-label mono" data-recon-label>UGV launch deck · quadrotor scout</p>
        <p class="deep__recon-path-label mono" data-recon-path-label hidden>Low risk · recommended corridor</p>
        <aside class="deep__pilot deep__recon mono" data-recon-panel hidden aria-label="Forest corridor reconnaissance assessment">
          <p class="deep__pilot-status" data-recon-status>Scout launching · UGV holding</p>
          <p class="deep__pilot-key" data-recon-summary>Surveying the route ahead</p>
          <ol>
            {['direct', 'drainage', 'flank'].map((id) => (
              <li data-recon-route={id}>
                <div><span data-recon-name></span><b data-recon-score>Unobserved</b></div>
                <span class="deep__pilot-bar"><i data-recon-bar></i></span>
                <small data-recon-reason></small>
              </li>
            ))}
          </ol>
          <p class="deep__pilot-note">Observed hazards · route recommendation for the ground team</p>
        </aside>
        <p class="deep__pilot-label mono" data-pilot-label>Gear camera · low visibility</p>
        <aside class="deep__pilot mono" data-pilot-panel hidden aria-label="Landing approach assessment">
          <p class="deep__pilot-status" data-pilot-status>Assessing landing terrain</p>
          <p class="deep__pilot-key" data-pilot-sampling>3 approaches compared</p>
          <ol>
            {['ridge', 'rough', 'clearing'].map((id) => (
              <li data-landing-route={id}>
                <div><span data-landing-name></span><b data-landing-score>–</b></div>
                <span class="deep__pilot-bar"><i data-landing-bar></i></span>
                <small data-landing-reason></small>
              </li>
            ))}
          </ol>
          <p class="deep__pilot-note">Illustrative assessment · pilot retains control</p>
        </aside>
        <div class="deep__copy">
          <p class="eyebrow" data-application-title>Application · under-canopy reconnaissance</p>
          {[['forest', forestBeats], ['air', airBeats], ['ground', beats], ['pilot', pilotBeats]].map(([k, list]) => (
            <ol class="deep__beats" data-beats={k as string} hidden={k !== 'forest'}>
              {(list as typeof beats).map((b, i) => (
                <li data-beat={i}>
                  <h2 class="headline">{b.h}</h2>
                  <p class="lede">{b.p}</p>
                </li>
              ))}
            </ol>
          ))}
        </div>
        <div class="deep__hud mono">
          <span><b data-hud="dist">0</b> m travelled</span>
          <span><b data-hud="mapped">0</b>% of passage mapped</span>
          <span><b data-hud="unc">–</b> mean uncertainty</span>
        </div>
        <div class="deep__legend mono" aria-hidden="true">
          <span class="deep__ramp"></span><span>Low → high risk</span>
          <span class="deep__unk"></span><span>Not yet observed</span>
        </div>
      </div>
    </section>

    <section class="sec" data-sec="close" id="contact" style="--h: 130vh">
      <div class="sticky">
        <div class="panel panel--center" data-fade>
          <p class="chain mono"><span>Autonomy at scale <b aria-hidden="true">→</b><i class="sr-only">gives</i></span><span>Defensive and offensive superiority <b aria-hidden="true">→</b><i class="sr-only">which leads to</i></span></p>
          <h2 class="display">Deterrence<br /><em>through autonomy.</em></h2>
          <p class="lede">Building the autonomy layer for machines operating where the world is uncertain.</p>
          <div class="ctas">
            <a class="btn" href="#contact" data-contact="Partnership">Partner with us</a>
            <a class="btn btn--ghost" href="#contact" data-contact="Careers">Join the team</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <div class="foot"><SiteFooter /></div>
  <ContactDialog />
</Base>

<script>
  import { initMotion, hasWebGL, prefersReducedMotion, range, smooth, clamp, whenNear, visibleLoop, fitCanvas } from '../lib/motion';
  import type { SceneState } from '../components/candidate-a/sceneA';
  import { A_EXTENT, A_GOAL, A_HUB, A_LINK_DIST, A_WORLD } from '../components/candidate-a/worldA';

  const { gsap } = initMotion();
  const reduced = prefersReducedMotion();
  type Key = { sec: string; at: number; s: Partial<SceneState> };

  /* Scene keyframes anchored to section scroll progress (0 = section top at viewport top). */
  const KEYS: Key[] = [
    { sec: 'hero', at: 0, s: { relief: 1, structured: 0, belief: 0, points: 0, risk: 0, field: 0, plans: 0, lens: 1, known: 0, profile: 0, team: 0, others: 0, dist: 3.4, elev: 0.36, azim: 0.9, focus: 0, dim: 0, comm: 0, bev: 0 } },
    { sec: 'hero', at: 0.6, s: { lens: 1, dist: 3.8 } },
    { sec: 'shift', at: 0, s: { lens: 0, dist: 4.2, elev: 0.42, azim: 1.5 } },
    { sec: 'shift', at: 0.8, s: { dist: 5.2, elev: 0.62 } },
    { sec: 'world', at: 0, s: { structured: 1, relief: 0.03, dist: 6, elev: 0.85, azim: 1.7 } },
    { sec: 'world', at: 0.25, s: { structured: 1, relief: 0.03 } },
    { sec: 'world', at: 0.85, s: { structured: 0, relief: 1, dist: 4.4, elev: 0.55, azim: 1.9 } },
    { sec: 'reason', at: 0, s: { belief: 0, points: 0, dim: 0, dist: 3.1, elev: 0.5, azim: 2.1 } },
    { sec: 'reason', at: 0.14, s: { points: 0, dim: 0 } },
    { sec: 'reason', at: 0.26, s: { points: 1, dim: 0.8, dist: 2.7 } },
    { sec: 'reason', at: 0.36, s: { belief: 0 } },
    { sec: 'reason', at: 0.48, s: { belief: 1, known: 0.15, points: 0.35, dim: 0.8, dist: 3.4, elev: 0.62 } },
    { sec: 'reason', at: 0.56, s: { risk: 0, field: 0 } },
    { sec: 'reason', at: 0.68, s: { risk: 1, field: 1, points: 0, known: 0.3, elev: 0.66 } },
    { sec: 'reason', at: 0.76, s: { plans: 0 } },
    { sec: 'reason', at: 0.88, s: { plans: 1, dist: 3, elev: 0.6, azim: 2.4 } },
    { sec: 'link', at: 0, s: { comm: 0 } },
    { sec: 'link', at: 0.22, s: { plans: 0, field: 0, risk: 0, points: 0, belief: 0, dim: 0, dist: 3.2, elev: 0.75 } },
    { sec: 'link', at: 0.4, s: { comm: 1 } },
    { sec: 'link', at: 0.72, s: { bev: 1, dist: A_LINK_DIST, elev: 1.5, azim: Math.PI / 2 } },
    { sec: 'force', at: 0.1, s: {} },
    { sec: 'close', at: 0, s: { comm: 0, bev: 0, known: 0, team: 0, others: 0, focus: 0, belief: 0, risk: 0, plans: 0, points: 0, dim: 0, lens: 1, dist: 3, elev: 0.22, azim: 5.2 } },
  ];

  const sections = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-sec]').forEach((el) => sections.set(el.dataset.sec!, el));

  let anchors: { y: number; s: SceneState }[] = [];
  /* The lead vehicle's progress to its goal is tied linearly to scroll, from the top of the
     page to the moment it stops in "Connected", so it never has to rush to catch up. */
  let driveEnd = 1;
  const driveAt = (y: number) => clamp(y / driveEnd);
  function layoutKeys() {
    const vh = window.innerHeight;
    const link = sections.get('link')!;
    driveEnd = Math.max(1, link.getBoundingClientRect().top + window.scrollY + 0.22 * Math.max(0, link.offsetHeight - vh));
    let acc = { ...KEYS[0].s } as SceneState;
    anchors = KEYS.map((k) => {
      const el = sections.get(k.sec)!;
      const top = el.getBoundingClientRect().top + window.scrollY;
      const span = Math.max(0, el.offsetHeight - vh);
      acc = { ...acc, ...k.s };
      return { y: top + k.at * span, s: acc };
    });
  }

  function stateAt(y: number): SceneState {
    return { ...keyState(y), drive: driveAt(y) };
  }

  function keyState(y: number): SceneState {
    if (y <= anchors[0].y) return anchors[0].s;
    for (let i = 1; i < anchors.length; i++) {
      const a = anchors[i - 1];
      const b = anchors[i];
      if (y <= b.y) {
        const t = smooth(range(y, a.y, b.y));
        const out = {} as SceneState;
        for (const key in b.s) {
          const k = key as keyof SceneState;
          out[k] = a.s[k] + (b.s[k] - a.s[k]) * t;
        }
        return out;
      }
    }
    return anchors[anchors.length - 1].s;
  }

  /* Text panels fade in/out as each sticky section passes. */
  document.querySelectorAll<HTMLElement>('[data-fade]').forEach((panel) => {
    const sec = panel.closest('[data-sec]') as HTMLElement;
    gsap.timeline({ scrollTrigger: { trigger: sec, start: 'top 75%', end: 'bottom 25%', scrub: reduced ? true : 0.6 } })
      .fromTo(panel, { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, duration: 1, ease: 'power2.out' })
      .to(panel, { autoAlpha: 1, duration: 3 })
      .to(panel, { autoAlpha: 0, y: -40, duration: 1, ease: 'power2.in' });
  });
  gsap.to('[data-hero]', {
    autoAlpha: 0, y: -60,
    scrollTrigger: { trigger: sections.get('hero'), start: 'top top', end: 'bottom 40%', scrub: 0.6 },
  });

  /* Section-local UI driven from scroll position. */
  const rail = document.querySelector<HTMLElement>('[data-rail]')!;
  const railItems = [...rail.querySelectorAll<HTMLElement>('[data-stage]')];
  const railFill = document.querySelector<HTMLElement>('[data-rail-fill]')!;
  const stageTitles = [...document.querySelectorAll<HTMLElement>('[data-stage-title]')];
  const coverers = [sections.get('deep')!];
  let forceOpacity = 0;
  const STAGE_AT = [0, 0.2, 0.4, 0.6, 0.8];
  let reasonStage = 0;
  const annotations = document.querySelector<HTMLElement>('[data-scene-annotations]')!;
  const annotationSvg = annotations.querySelector<SVGSVGElement>('[data-scene-arrows]')!;
  const annotationTitle = annotations.querySelector<HTMLElement>('[data-scene-label-title]')!;
  const annotationCopy = annotations.querySelector<HTMLElement>('[data-scene-label-copy]')!;
  const annotationLabel = annotations.querySelector<HTMLElement>('[data-scene-label="feature"]')!;
  const annotationArrow = annotations.querySelector<SVGPathElement>('[data-scene-arrow="feature"]')!;
  let annotationIdleAt = performance.now() + 450;
  const hideAnnotations = () => {
    annotations.hidden = true;
    annotationIdleAt = performance.now() + 450;
  };
  window.addEventListener('scroll', hideAnnotations, { passive: true });
  window.addEventListener('resize', hideAnnotations, { passive: true });

  function sectionProgress(name: string) {
    const el = sections.get(name)!;
    const r = el.getBoundingClientRect();
    return clamp(-r.top / Math.max(1, el.offsetHeight - window.innerHeight));
  }

  function updateUI(_s: SceneState) {
    const p = sectionProgress('reason');
    let active = 0;
    STAGE_AT.forEach((a, i) => p >= a && (active = i));
    reasonStage = active;
    railItems.forEach((li, i) => li.classList.toggle('is-active', i === active));
    railItems.forEach((li, i) => li.classList.toggle('is-past', i < active));
    stageTitles.forEach((el, i) => {
      el.classList.toggle('is-active', i === active);
      if (i === active) el.removeAttribute('aria-hidden');
      else el.setAttribute('aria-hidden', 'true');
    });
    railFill.style.transform = `scaleY(${p})`;
  }

  function updateAnnotations(s: SceneState, scene: import('../components/candidate-a/sceneA').EyesScene, stationary: boolean) {
    const opening = annotations.hidden;
    const bounds = sections.get('reason')!.getBoundingClientRect();
    const kind = reasonStage === 1 ? 'perception' : reasonStage === 2 ? 'belief' : 'risk';
    const ready = reasonStage === 1 ? s.points > 0.25 : reasonStage === 2 ? s.belief > 0.25 : s.field > 0.3;
    annotations.hidden = !stationary || reasonStage < 1 || reasonStage > 3 || bounds.top > 0 || bounds.bottom < window.innerHeight || !ready;
    if (annotations.hidden) return;
    const copy = kind === 'perception' ? ['Sensor measurements', 'These points are returns from the robot’s sensors.']
      : kind === 'belief' ? ['The robot’s understanding', 'Lit contours show the surroundings it has mapped.']
      : ['Taller peaks mean higher risk', 'Raised areas show where movement is more risky.'];
    annotationTitle.textContent = copy[0]; annotationCopy.textContent = copy[1];
    annotationSvg.setAttribute('viewBox', `0 0 ${window.innerWidth} ${window.innerHeight}`);
    const target = scene.annotationAnchor(kind, opening);
    annotationLabel.hidden = !target.visible;
    annotationArrow.style.visibility = target.visible ? 'visible' : 'hidden';
    if (!target.visible) return;
    const box = annotationLabel.getBoundingClientRect();
    const x = target.x < box.left ? box.left : target.x > box.right ? box.right : (box.left + box.right) / 2;
    const y = target.x >= box.left && target.x <= box.right ? (target.y < box.top ? box.top : box.bottom) : box.top + box.height / 2;
    const mid = (x + target.x) / 2;
    annotationArrow.setAttribute('d', `M${x.toFixed(1)},${y.toFixed(1)} L${mid.toFixed(1)},${y.toFixed(1)} L${target.x.toFixed(1)},${target.y.toFixed(1)}`);
  }

  /* Bird's-eye chapter: a fixed Canvas 2D layer that takes over from the 3D view
     once its camera is looking straight down on the stopped vehicle. */
  const forceSec = sections.get('force')!;
  const forceWrap = document.querySelector<HTMLElement>('[data-force-wrap]')!;
  const forceCanvas = document.getElementById('a-force') as HTMLCanvasElement;
  const forceCaps = [...forceSec.querySelectorAll<HTMLElement>('[data-fcap]')];
  const deepEl = sections.get('deep')!;
  function updateForceFade() {
    const live = deepEl.getBoundingClientRect().top > 0;
    forceOpacity = live ? smooth(range(sectionProgress('link'), 0.74, 0.96)) : 0;
    forceWrap.style.opacity = String(forceOpacity);
    forceWrap.style.visibility = forceOpacity > 0.001 ? 'visible' : 'hidden';
  }
  updateForceFade();
  window.addEventListener('scroll', updateForceFade, { passive: true });

  whenNear(sections.get('link')!, async () => {
    const [{ ForceScene, forceStage, stateAt: forceAt }, { createWorld }] = await Promise.all([
      import('../components/candidate-a/forceScene'),
      import('../lib/world'),
    ]);
    const lowPower = window.innerWidth < 760 || (navigator.hardwareConcurrency ?? 8) <= 4;
    const fov = ((window.innerWidth < 700 ? 55 : 42) * Math.PI) / 180;
    const z0 = (2 * A_LINK_DIST * Math.tan(fov / 2)) / A_EXTENT;
    const stages = [
      forceStage({ z: z0, uplink: 1, move: 0, engine: 1 }),
      forceStage({ z: 0.42, follow: 0.5, uplink: 1, others: 1, fog: 0.35, threats: 0.3, engine: 0.7 }),
      forceStage({ z: 1.08, cx: 0.5, cy: 0.5, follow: 0, uplink: 1, others: 1, team: 1, operator: 1, network: 1, fog: 0.45, threats: 0.35, risk: 0.1 }),
    ];
    const N = stages.length - 1;
    const HOLD = 0.5;
    const scene = new ForceScene(forceCanvas, {
      lowPower,
      markerScale: 1.25,
      reducedMotion: reduced,
      softEdges: true,
      world: createWorld(A_WORLD),
      start: { ...A_GOAL, heading: -0.6 },
      hub: A_HUB,
      teams: [{ u: 0.28, v: 0.28 }, { u: 0.5, v: 0.8 }],
      operators: [{ u: 0.16, v: 0.16 }, { u: 0.32, v: 0.9 }],
    });
    scene.resize();
    window.addEventListener('resize', () => scene.resize());
    await scene.build(lowPower);
    forceCanvas.classList.add('is-ready');
    const bar = forceSec.querySelector<HTMLElement>('[data-bar]')!;
    const km = forceSec.querySelector<HTMLElement>('[data-km]')!;
    const nEls = Object.fromEntries([...forceSec.querySelectorAll<HTMLElement>('[data-n]')].map((el) => [el.dataset.n!, el]));
    const nice = [0.05, 0.1, 0.2, 0.5, 1, 2, 5, 10, 20];
    let shown = 0;
    let hudTick = 0;
    visibleLoop(forceCanvas, (_t, dt) => {
      if (forceOpacity < 0.001) return;
      const f = Math.min(N, sectionProgress('force') * (N + HOLD));
      shown = reduced ? f : shown + (f - shown) * Math.min(1, dt * 6);
      const st = forceAt(shown, stages);
      if (st.move < 0.01 && eyes) scene.setHero(eyes.mainPose());
      scene.frame(dt, st);
      const idx = Math.round(shown) - 1;
      forceCaps.forEach((el, i) => el.classList.toggle('is-on', i === idx));
      if (hudTick++ % 6) return;
      const kpp = scene.kmPerPx(st);
      const len = nice.find((n) => n / kpp > 70) ?? 20;
      bar.style.width = `${(len / kpp).toFixed(0)}px`;
      km.textContent = len < 1 ? `${len * 1000} m` : `${len} km`;
      const c = scene.counts(st);
      for (const key of ['machines', 'operators', 'teams'] as const) nEls[key].textContent = String(c[key]);
    });
  }, '600px');

  /* Fieldcore demos: forest reconnaissance, fixed-wing, underground, pilot assistance. */
  const deepSec = sections.get('deep')!;
  whenNear(deepSec, async () => {
    const [{ createPassage, passageStats }, { createLandingAssessment, landingState }, forestModel] = await Promise.all([
      import('../lib/passage'), import('../lib/landing'), import('../lib/forestRecon'),
    ]);
    const lowPower = window.innerWidth < 760 || (navigator.hardwareConcurrency ?? 8) <= 4;
    const P = createPassage({ res: lowPower ? 160 : 224 });
    type DemoTab = 'forest' | 'air' | 'ground' | 'pilot';
    let tab: DemoTab = 'forest';
    const hasAir = hasWebGL();
    const demos: DemoTab[] = hasAir ? ['forest', 'air', 'ground', 'pilot'] : ['forest', 'ground', 'pilot'];
    if (!hasAir) deepSec.style.setProperty('--h', '1840vh');
    const demoProgress = (demo = tab) => {
      const p = sectionProgress('deep');
      return clamp(p * demos.length - demos.indexOf(demo));
    };
    // Ignore floating-point noise at the exact boundary between chapters.
    const tabAtScroll = () => demos[Math.min(demos.length - 1, Math.floor(sectionProgress('deep') * demos.length + 1e-9))];
    const beatLists = Object.fromEntries(
      [...deepSec.querySelectorAll<HTMLElement>('[data-beats]')].map((ol) => [ol.dataset.beats!, ol]),
    );
    const beatsNow = () => [...beatLists[tab].querySelectorAll<HTMLElement>('[data-beat]')];
    const hud = (k: string) => deepSec.querySelector<HTMLElement>(`[data-hud="${k}"]`)!;
    const [hDist, hMapped, hUnc] = [hud('dist'), hud('mapped'), hud('unc')];
    const sJ = P.junction;
    const sEnd = P.length - 0.05;
    const routeEls = {
      direct: deepSec.querySelector<HTMLElement>('[data-route="direct"]')!,
      detour: deepSec.querySelector<HTMLElement>('[data-route="detour"]')!,
    };
    deepSec.querySelector('[data-len="direct"]')!.textContent = P.directLen.toFixed(0);
    deepSec.querySelector('[data-len="detour"]')!.textContent = P.detourLen.toFixed(0);
    /* drive to the fork, hold while it weighs both branches, then take the detour */
    /* to the fork, a few metres down the direct branch, hold while the drop resolves,
       reverse out, then the detour */
    const target = () => {
      const p = demoProgress('ground');
      if (p < 0.2) return 2 + range(p, 0.03, 0.2) * (sJ - 2);
      if (p < 0.32) return sJ + smooth(range(p, 0.2, 0.32)) * (P.probe - sJ);
      if (p < 0.44) return P.probe;
      if (p < 0.54) return P.probe + smooth(range(p, 0.44, 0.54)) * (P.back - P.probe);
      return P.back + range(p, 0.54, 0.95) * (sEnd - P.back);
    };
    const viewAt = () => {
      const p = demoProgress('ground');
      return { look: 0, compare: smooth(range(p, 0.33, 0.38)), decided: smooth(range(p, 0.41, 0.45)) };
    };
    let s = target();
    let lastStat = -1;
    const routes = (v: { compare: number; decided: number }, at?: { direct: readonly [number, number]; detour: readonly [number, number] }) => {
      for (const k of ['direct', 'detour'] as const) {
        const el = routeEls[k];
        el.classList.toggle('is-on', v.compare > 0.5);
        el.classList.toggle('is-chosen', k === 'detour' && v.decided > 0.5);
        el.classList.toggle('is-rejected', k === 'direct' && v.decided > 0.5);
        if (at) el.style.transform = `translate(${at[k][0].toFixed(0)}px, ${at[k][1].toFixed(0)}px)`;
      }
    };
    const ui = (now: number) => {
      const beatEls = beatsNow();
      const bi = Math.min(beatEls.length - 1, Math.floor(demoProgress() * beatEls.length));
      beatEls.forEach((el, i) => el.classList.toggle('is-active', i === bi));
      if (tab !== 'ground') return;
      if (now - lastStat < 0.2) return;
      lastStat = now;
      const st = passageStats(P, s);
      hDist.textContent = s.toFixed(1);
      hMapped.textContent = String(Math.round(st.mapped * 100));
      hUnc.textContent = st.meanUnc.toFixed(2);
    };
    const step = (dt: number) => (s += (target() - s) * (reduced ? 1 : 1 - Math.exp(-dt * 5)));

    const gl = document.getElementById('a-deep') as HTMLCanvasElement;
    const flat = document.getElementById('a-deep-2d') as HTMLCanvasElement;
    let groundScene: import('../components/candidate-a/deepScene').DeepScene | null = null;
    let groundMap: import('../lib/passageMap2d').PassageMap2D | null = null;
    if (hasAir) {
      const { DeepScene } = await import('../components/candidate-a/deepScene');
      groundScene = new DeepScene(gl, P, { lowPower });
      groundScene.resize();
      window.addEventListener('resize', () => groundScene?.resize());
      gl.classList.add('is-ready');
    } else {
      const { PassageMap2D } = await import('../lib/passageMap2d');
      deepSec.classList.add('is-flat');
      groundMap = new PassageMap2D(flat, P);
      flat.classList.add('is-ready');
    }

    const airCanvas = document.getElementById('a-air') as HTMLCanvasElement;
    const forestCanvas = document.getElementById('a-forest') as HTMLCanvasElement;
    const pilotCanvas = document.getElementById('a-pilot') as HTMLCanvasElement;
    const airEls = Object.fromEntries(
      [...deepSec.querySelectorAll<HTMLElement>('[data-air]')].map((el) => [el.dataset.air!, el]),
    ) as Record<'radar' | 'planned' | 'detour', HTMLElement>;
    const tabs = [...deepSec.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    tabs.forEach(b => { b.hidden = !demos.includes(b.dataset.tab as DemoTab); });
    let air: import('../components/candidate-a/airScene').AirScene | null = null;
    let airLoading: Promise<void> | null = null;
    let pilot: { resize(): void; frame(dt: number, progress: number): void } | null = null;
    let pilotLoading: Promise<void> | null = null;
    let forest: { resize(): void; frame(dt: number, progress: number): void; lowRiskAnchor?(): { x: number; y: number; visible: boolean } } | null = null;
    let forestLoading: Promise<void> | null = null;
    let sa = 0;
    let sp = 0;
    let sf = 0;
    const airTarget = () => range(demoProgress('air'), 0.03, 0.95);
    const airView = () => {
      const p = demoProgress('air');
      return { detect: smooth(range(p, 0.27, 0.34)), decided: smooth(range(p, 0.42, 0.49)) };
    };
    const assessment = createLandingAssessment();
    const trajectoryCount = lowPower ? 64 : 128;
    const pilotPanel = deepSec.querySelector<HTMLElement>('[data-pilot-panel]')!;
    const pilotStatus = deepSec.querySelector<HTMLElement>('[data-pilot-status]')!;
    const landingRows = assessment.routes.map(route => {
      const row = deepSec.querySelector<HTMLElement>(`[data-landing-route="${route.id}"]`)!;
      row.querySelector('[data-landing-name]')!.textContent = route.name;
      row.querySelector('[data-landing-reason]')!.textContent = `${route.reason} · ${route.slope.toFixed(1)}° max slope`;
      return { route, row, score: row.querySelector<HTMLElement>('[data-landing-score]')!, bar: row.querySelector<HTMLElement>('[data-landing-bar]')! };
    });
    const pilotUI = () => {
      const v = landingState(sp);
      pilotStatus.textContent = v.rollout > 0.3 ? 'Touchdown · guidance complete'
        : v.decided > 0.5 ? 'Lowest-risk approach · recommended'
        : v.compare > 0.5 ? 'Judging each approach' : 'Assessing terrain through haze';
      landingRows.forEach(({ route, row, score, bar }) => {
        const assessed = v.compare > 0.5;
        const chosen = v.decided > 0.5 && route.id === assessment.best.id;
        row.classList.toggle('is-chosen', chosen);
        row.classList.toggle('is-rejected', v.decided > 0.5 && !chosen);
        score.textContent = assessed ? `${route.score} / 100` : 'Scanning';
        bar.style.width = `${assessed ? route.score : 0}%`;
      });
    };
    const recon = forestModel.createForestRecon();
    const reconSamples = forestModel.forestObservationSamples(recon);
    const reconPanel = deepSec.querySelector<HTMLElement>('[data-recon-panel]')!;
    const reconStatus = deepSec.querySelector<HTMLElement>('[data-recon-status]')!;
    const reconSummary = deepSec.querySelector<HTMLElement>('[data-recon-summary]')!;
    const reconLabel = deepSec.querySelector<HTMLElement>('[data-recon-label]')!;
    const pathLabel = deepSec.querySelector<HTMLElement>('[data-recon-path-label]')!;
    const hazardSeen = recon.hazards.map(h => forestModel.forestObservedAt(reconSamples, h.x, h.z));
    const reconRows = recon.routes.map(route => {
      const row = deepSec.querySelector<HTMLElement>(`[data-recon-route="${route.id}"]`)!;
      row.querySelector('[data-recon-name]')!.textContent = route.name;
      return { route, row, score: row.querySelector<HTMLElement>('[data-recon-score]')!,
        bar: row.querySelector<HTMLElement>('[data-recon-bar]')!, reason: row.querySelector<HTMLElement>('[data-recon-reason]')! };
    });
    const forestUI = () => {
      const state = forestModel.forestState(sf);
      const detected = hazardSeen.filter(at => sf >= at).length;
      reconStatus.textContent = state.ugv > 0.02 ? 'UGV moving · following low-risk corridor'
        : state.recommended > 0.5 ? 'Low-risk corridor · UGV ready'
        : sf > 0.5 ? 'Scouting the eastern corridor'
        : detected ? 'Hazards detected · assessing corridors' : 'Scout launching · UGV holding';
      reconLabel.textContent = sf < 0.1 ? 'UGV launch deck · quadrotor scout'
        : sf < 0.875 ? 'Under-canopy route reconnaissance' : 'UGV · following low-risk corridor';
      deepSec.querySelector('.deep__tag--r')!.textContent = state.recommended > 0.5 ? 'Low-risk corridor · route for the UGV' : 'Observed terrain · route assessment';
      deepSec.style.setProperty('--recon-cut-opacity', String(reduced ? 0 : Math.max(0, 1 - Math.abs(sf - 0.875) / 0.016)));
      const anchor = forest?.lowRiskAnchor?.();
      pathLabel.hidden = state.recommended < 0.5 || !anchor?.visible;
      if (anchor) { pathLabel.style.left = `${anchor.x}px`; pathLabel.style.top = `${anchor.y}px`; }
      reconSummary.textContent = `${detected} hazards mapped · ${state.recommended > 0.5 ? `${recon.best.length.toFixed(0)} m corridor scouted` : 'unobserved ground stays unknown'}`;
      reconRows.forEach(({ route, row, score, bar, reason }) => {
        const observed = route.id === 'direct' ? sf >= Math.max(hazardSeen[0], hazardSeen[1])
          : route.id === 'drainage' ? sf >= hazardSeen[2] : sf >= 0.8;
        const chosen = state.recommended > 0.5 && route.id === recon.best.id;
        row.classList.toggle('is-chosen', chosen);
        row.classList.toggle('is-rejected', state.recommended > 0.5 && !chosen);
        score.textContent = observed ? `${route.score} / 100` : route.id === recon.best.id && sf > 0.5 ? 'Scouting' : 'Unobserved';
        bar.style.width = `${observed ? route.score : 0}%`;
        reason.textContent = chosen ? 'Low-risk corridor · ready for the UGV' : observed ? route.reason : 'Awaiting scout observations';
      });
    };
    const setTab = (t: DemoTab) => {
      tab = t;
      deepSec.dataset.tab = t;
      tabs.forEach(b => {
        b.setAttribute('aria-selected', String(b.dataset.tab === t));
        b.tabIndex = b.dataset.tab === t ? 0 : -1;
      });
      Object.entries(beatLists).forEach(([k, ol]) => { ol.hidden = k !== t; });
      airCanvas.hidden = t !== 'air';
      pilotCanvas.hidden = t !== 'pilot';
      forestCanvas.hidden = t !== 'forest';
      gl.hidden = t !== 'ground' || !hasAir;
      flat.hidden = t !== 'ground' || hasAir;
      pilotPanel.hidden = t !== 'pilot';
      reconPanel.hidden = t !== 'forest';
      deepSec.querySelector('[data-application-title]')!.textContent = `Application · ${
        { forest: 'under-canopy reconnaissance', air: 'fixed-wing under radar', ground: 'GPS-denied underground', pilot: 'manned pilot assistance' }[t]}`;
      deepSec.querySelector('.deep__tag--r')!.textContent = t === 'forest' ? 'Observed terrain · route assessment'
        : t === 'pilot' ? 'Terrain risk · approach options' : 'Belief · risk map';
      if (t === 'forest' && !forestLoading) {
        forestLoading = (hasAir
          ? import('../components/candidate-a/forestScene').then(({ ForestScene }) => new ForestScene(forestCanvas, { lowPower, reducedMotion: reduced, model: recon }))
          : import('../lib/forestMap2d').then(({ ForestMap2D }) => new ForestMap2D(forestCanvas, { model: recon }))
        ).then(scene => {
          forest = scene;
          window.addEventListener('resize', () => forest?.resize());
          if (tab === 'forest') forest.resize();
          forestCanvas.classList.add('is-ready');
        });
      }
      if (t === 'air' && !airLoading) {
        airLoading = import('../components/candidate-a/airScene').then(({ AirScene }) => {
          air = new AirScene(airCanvas, { lowPower });
          window.addEventListener('resize', () => air?.resize());
          if (tab === 'air') air.resize();
          airCanvas.classList.add('is-ready');
        });
      }
      if (t === 'pilot' && !pilotLoading) {
        pilotLoading = (hasAir
          ? import('../components/candidate-a/landingScene').then(({ LandingScene }) => new LandingScene(pilotCanvas, { lowPower, reducedMotion: reduced }))
          : import('../lib/landingMap2d').then(({ LandingMap2D }) => new LandingMap2D(pilotCanvas, { sampleCount: trajectoryCount }))
        ).then(scene => {
          pilot = scene;
          window.addEventListener('resize', () => pilot?.resize());
          if (tab === 'pilot') pilot.resize();
          pilotCanvas.classList.add('is-ready');
        });
      }
      s = target();
      sa = airTarget();
      sp = demoProgress('pilot');
      sf = demoProgress('forest');
      lastStat = -1;
      if (t === 'air') air?.resize();
      if (t === 'ground') groundScene?.resize();
      if (t === 'pilot') { pilot?.resize(); pilotUI(); }
      if (t === 'forest') { forest?.resize(); forestUI(); }
    };
    tabs.forEach(b => b.addEventListener('click', () => {
      const next = b.dataset.tab as DemoTab;
      if (next === tab || !demos.includes(next)) return;
      const start = deepSec.getBoundingClientRect().top + window.scrollY;
      const span = Math.max(1, deepSec.offsetHeight - window.innerHeight);
      window.scrollTo({ top: start + span * demos.indexOf(next) / demos.length + 2, behavior: 'auto' });
      setTab(next);
    }));
    tabs.forEach(b => b.addEventListener('keydown', event => {
      const index = demos.indexOf(b.dataset.tab as DemoTab);
      const next = event.key === 'ArrowRight' ? (index + 1) % demos.length
        : event.key === 'ArrowLeft' ? (index + demos.length - 1) % demos.length
        : event.key === 'Home' ? 0 : event.key === 'End' ? demos.length - 1 : -1;
      if (next < 0) return;
      event.preventDefault();
      const button = tabs.find(t => t.dataset.tab === demos[next])!;
      button.focus();
      button.click();
    }));
    setTab(tabAtScroll());

    visibleLoop(deepSec, (t, dt) => {
      const next = tabAtScroll();
      if (next !== tab) setTab(next);
      ui(t);
      if (tab === 'forest') {
        sf += (demoProgress('forest') - sf) * (reduced ? 1 : 1 - Math.exp(-dt * 5));
        forest?.frame(dt, sf);
        forestUI();
        return;
      }
      if (tab === 'pilot') {
        sp += (demoProgress('pilot') - sp) * (reduced ? 1 : 1 - Math.exp(-dt * 5));
        pilot?.frame(dt, sp);
        pilotUI();
        return;
      }
      if (tab === 'air') {
        if (!air) return;
        sa += (airTarget() - sa) * (reduced ? 1 : 1 - Math.exp(-dt * 5));
        const v = airView();
        air.frame(dt, sa, v);
        const at = air.anchors();
        for (const k of ['radar', 'planned', 'detour'] as const) {
          const el = airEls[k];
          el.classList.toggle('is-on', v.detect > 0.5 && (k !== 'detour' || v.decided > 0.2));
          el.classList.toggle('is-rejected', k === 'planned' && v.decided > 0.5);
          el.classList.toggle('is-chosen', k === 'detour' && v.decided > 0.5);
          el.style.transform = `translate(${at[k][0].toFixed(0)}px, ${at[k][1].toFixed(0)}px)`;
        }
        return;
      }
      step(dt);
      const v = viewAt();
      if (groundScene) {
        groundScene.frame(dt, s, v);
        routes(v, groundScene.anchors());
      } else if (groundMap) {
        fitCanvas(flat, 1.5);
        groundMap.draw(s, t, v.compare);
        routes(v);
      }
    });
  }, '900px');

  /* Scene boot: lazy so hero text paints first. */
  const canvas = document.getElementById('a-gl') as HTMLCanvasElement;
  const fallback = document.getElementById('a-fallback') as HTMLCanvasElement;

  let eyes: { mainPose(): { u: number; v: number; heading: number } } | null = null;
  async function boot() {
    layoutKeys();
    window.addEventListener('resize', layoutKeys);
    const ro = new ResizeObserver(layoutKeys);
    ro.observe(document.body);

    if (!hasWebGL()) {
      canvas.hidden = true;
      fallback.hidden = false;
      const [{ SimView }, { createWorld }, { fitCanvas, visibleLoop }] = await Promise.all([
        import('../lib/simView'),
        import('../lib/world'),
        import('../lib/motion'),
      ]);
      fitCanvas(fallback, 1);
      const view = new SimView(fallback, createWorld({ size: 128, seed: 11 }), 'belief', 30);
      fallback.classList.add('is-ready');
      visibleLoop(fallback, (t) => {
        fitCanvas(fallback, 1);
        view.draw(t);
        updateUI(stateAt(window.scrollY));
      });
      return;
    }

    const { EyesScene } = await import('../components/candidate-a/sceneA');
    const lowPower = window.innerWidth < 760 || (navigator.hardwareConcurrency ?? 8) <= 4;
    const scene = new EyesScene(canvas, { lowPower });
    eyes = scene;
    scene.resize();
    window.addEventListener('resize', () => scene.resize());
    window.addEventListener('pointermove', (e) => scene.setPointer(e.clientX, e.clientY), { passive: true });

    let cur = stateAt(window.scrollY);
    let last = performance.now();
    let first = true;
    const tick = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      const target = stateAt(window.scrollY);
      const k = reduced ? 1 : 1 - Math.exp(-dt * 6);
      let stationary = now >= annotationIdleAt;
      for (const key in target) {
        const kk = key as keyof SceneState;
        cur[kk] += (target[kk] - cur[kk]) * k;
        if (Math.abs(target[kk] - cur[kk]) > 0.003) stationary = false;
      }
      updateUI(cur);
      const covered = forceOpacity > 0.999 || coverers.some((el) => {
        const r = el.getBoundingClientRect();
        return r.top <= 0 && r.bottom >= window.innerHeight;
      });
      if (!covered && !document.hidden) {
        scene.frame(dt, cur);
        updateAnnotations(cur, scene, stationary);
        if (first) {
          canvas.classList.add('is-ready');
          first = false;
        }
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  if ('requestIdleCallback' in window) requestIdleCallback(() => boot(), { timeout: 300 });
  else setTimeout(boot, 50);
</script>

<style>
  .gl-wrap {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: radial-gradient(120% 80% at 70% 60%, #15161a 0%, var(--bg) 60%);
  }
  .gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.6s var(--ease);
  }
  .gl:global(.is-ready) {
    opacity: 1;
  }
  #a-fallback:global(.is-ready) {
    opacity: 0.6;
  }
  .vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(6, 7, 8, 0.85) 0%, rgba(6, 7, 8, 0.2) 45%, rgba(6, 7, 8, 0) 70%),
      linear-gradient(0deg, rgba(6, 7, 8, 0.6) 0%, rgba(6, 7, 8, 0) 30%);
  }
  main {
    position: relative;
    z-index: 1;
  }
  .sec {
    position: relative;
    height: var(--h, 100vh);
  }
  .sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 var(--pad);
    pointer-events: none;
  }
  .sticky :global(a) {
    pointer-events: auto;
  }
  .panel {
    display: grid;
    gap: 22px;
    max-width: 620px;
  }
  .panel--right {
    margin-left: auto;
  }
  .panel--center {
    margin: 0 auto;
    text-align: center;
    justify-items: center;
    max-width: 900px;
  }
  .panel--hero {
    max-width: 900px;
    gap: 26px;
  }
  em {
    font-style: italic;
    color: var(--fg-dim);
  }
  .display em,
  .headline em {
    color: inherit;
    opacity: 0.72;
  }
  .chain {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px 14px;
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .chain span {
    white-space: nowrap;
  }
  .chain b {
    font-weight: inherit;
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .chain {
      font-size: 11px;
      letter-spacing: 0.1em;
    }
  }
  .hint {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-top: 16px;
  }
  .hint__lens {
    width: 18px;
    height: 18px;
    border: 1px solid currentColor;
    border-radius: 50%;
    animation: pulse 2.4s var(--ease) infinite;
  }
  @keyframes pulse {
    50% {
      transform: scale(1.35);
      opacity: 0.4;
    }
  }
  .versus {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-top: 10px;
  }
  .versus ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 17px;
  }
  .versus div:first-child ul {
    color: var(--fg-faint);
    text-decoration: line-through;
    text-decoration-color: rgba(235, 231, 222, 0.25);
  }
  .eyebrow--accent {
    color: var(--accent);
  }

  /* signature stage rail */
  .reason {
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 16vh 0 10vh;
  }
  .reason__title {
    display: grid;
    font-size: clamp(28px, 3.4vw, 52px);
    max-width: 16em;
  }
  .reason__line {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
  }
  .reason__line.is-active,
  .reason__title:not(:has(.is-active)) .reason__line:first-child {
    opacity: 1;
    transform: none;
  }
  .reason__annotations {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    color: #b7d9dc;
  }
  .reason__annotations[hidden],
  .reason__callout[hidden] { display: none; }
  .reason__arrows { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .reason__arrows > path { fill: none; stroke: currentColor; stroke-width: 1.2; opacity: 0.8; }
  .reason__callout {
    position: absolute;
    display: grid;
    gap: 6px;
    max-width: 230px;
    padding: 11px 14px;
    border-left: 2px solid currentColor;
    background: rgba(6, 10, 12, 0.88);
    font-size: 12px;
    line-height: 1.45;
  }
  .reason__callout strong { color: var(--fg); font-weight: 500; }
  .reason__callout span { color: var(--fg-dim); }
  .reason__callout--feature { top: 29%; right: var(--pad); }
  .rail {
    position: relative;
    align-self: end;
    list-style: none;
    margin: 0;
    padding: 0 0 0 22px;
    display: grid;
    gap: 14px;
    max-width: 380px;
  }
  .rail__bar {
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 1px;
    background: var(--line);
  }
  .rail__fill {
    position: absolute;
    inset: 0;
    background: var(--fg);
    transform-origin: top;
    transform: scaleY(0);
  }
  .rail li {
    display: grid;
    gap: 4px;
    opacity: 0.45;
    transition: opacity 0.5s var(--ease);
  }
  .rail li.is-past {
    opacity: 0.62;
  }
  .rail li.is-active {
    opacity: 1;
  }
  .rail__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 10px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .rail__legend i {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 7px;
    border-radius: 2px;
    background: var(--c);
    vertical-align: -1px;
  }
  .rail__k {
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .rail__p {
    display: none;
  }
  .rail li.is-active .rail__p {
    display: block;
    color: var(--fg-dim);
  }
  .rail li.is-active .rail__k {
    color: var(--signal);
  }

  /* bird's-eye chapter */
  .force-wrap {
    position: fixed;
    inset: 0;
    z-index: 0;
    opacity: 0;
    visibility: hidden;
    background: #080a0b;
  }
  .force-wrap__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s var(--ease);
  }
  .force-wrap__canvas:global(.is-ready) {
    opacity: 1;
  }
  .force-wrap__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(8, 10, 11, 0.88) 0%, rgba(8, 10, 11, 0.5) 30%, rgba(8, 10, 11, 0) 55%),
      radial-gradient(ellipse at 60% 50%, transparent 55%, rgba(8, 10, 11, 0.7) 100%);
  }
  .force {
    position: relative;
    height: var(--h);
  }
  .force__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    pointer-events: none;
  }
  .force__caps {
    position: absolute;
    left: var(--pad);
    top: 0;
    bottom: 0;
    width: min(540px, 42vw);
  }
  .force__cap {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s var(--ease), transform 0.6s var(--ease);
  }
  .force__list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--fg-dim);
  }
  .force__list li {
    padding-left: 18px;
    border-left: 1px solid var(--signal);
  }
  .force__cap:global(.is-on) {
    opacity: 1;
    transform: none;
  }
  .force__hud {
    position: absolute;
    right: var(--pad);
    bottom: 32px;
    display: grid;
    gap: 12px;
    justify-items: end;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .force__counts {
    display: flex;
    gap: 22px;
  }
  .force__hud b {
    color: var(--fg);
    font-weight: 500;
    font-size: 13px;
    margin-right: 0.4em;
  }
  .force__scale {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .force__scale i {
    display: block;
    height: 6px;
    border: 1px solid var(--fg-dim);
    border-top: 0;
    transition: width 0.2s;
  }

  /* underground */
  .deep {
    position: relative;
    height: var(--h);
    background: #050506;
  }
  .deep__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  .deep__gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }
  .deep__gl.is-ready {
    opacity: 1;
  }
  .deep__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent calc(50% - 0.5px), var(--line) calc(50% - 0.5px), var(--line) calc(50% + 0.5px), transparent calc(50% + 0.5px)),
      linear-gradient(0deg, rgba(5, 5, 6, 0.92) 0%, rgba(5, 5, 6, 0) 46%),
      radial-gradient(ellipse 30% 60% at 25% 50%, transparent 55%, rgba(5, 5, 6, 0.55) 100%);
  }
  .deep__tag {
    position: absolute;
    top: 92px;
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .deep__tag--r {
    left: calc(50% + var(--pad));
  }
  .deep__copy {
    position: absolute;
    left: var(--pad);
    bottom: 9vh;
    width: min(440px, calc(50% - 2 * var(--pad)));
    display: grid;
    gap: 18px;
  }
  .deep__beats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .deep__beats li {
    grid-area: 1 / 1;
    display: grid;
    gap: 14px;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
  }
  .deep__beats li.is-active {
    opacity: 1;
    transform: none;
  }
  .deep__beats .headline {
    font-size: clamp(30px, 3.2vw, 46px);
  }
  .deep__hud {
    position: absolute;
    top: 120px;
    left: calc(50% + var(--pad));
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--fg-dim);
  }
  .deep__hud b {
    color: var(--fg);
    font-weight: 500;
  }
  .deep__legend {
    position: absolute;
    right: var(--pad);
    bottom: 9vh;
    display: grid;
    grid-template-columns: auto auto;
    gap: 10px 12px;
    align-items: center;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--fg-dim);
  }
  .deep__ramp,
  .deep__unk {
    width: 72px;
    height: 8px;
  }
  .deep__ramp {
    background: linear-gradient(90deg, rgb(58, 72, 82), rgb(168, 98, 36), rgb(255, 124, 52));
  }
  .deep__unk {
    background: repeating-linear-gradient(135deg, rgba(168, 98, 36, 0.45) 0 1px, #0b0c0e 1px 5px);
    outline: 1px solid var(--line);
  }
  .deep__route {
    position: absolute;
    left: 0;
    top: 0;
    margin: -9px 0 0 12px;
    padding: 4px 8px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    background: rgba(5, 5, 6, 0.8);
    border-left: 2px solid;
    opacity: 0;
    transition: opacity 0.5s var(--ease), color 0.5s var(--ease);
    pointer-events: none;
  }
  .deep__route b {
    font-weight: 500;
  }
  .deep__route--direct {
    color: #ff7a5c;
    border-color: #ff4a2e;
  }
  .deep__route--detour {
    color: #bfeeff;
    border-color: #a8e6ff;
  }
  .deep__route:global(.is-on) {
    opacity: 1;
  }
  .deep__route--direct:global(.is-rejected) {
    opacity: 0.55;
    text-decoration: line-through;
  }
  .deep__route--detour:global(.is-chosen)::after {
    content: ' · chosen';
    color: var(--fg);
  }
  .deep.is-flat .deep__route,
  .deep__air,
  .deep:not([data-tab='ground']) .deep__route,
  .deep:not([data-tab='ground']) .deep__hud,
  .deep:not([data-tab='ground']) .deep__legend {
    display: none;
  }
  .deep[data-tab='air'] .deep__air {
    display: block;
  }
  .deep__air {
    position: absolute;
    left: 0;
    top: 0;
    margin: -9px 0 0 12px;
    padding: 4px 8px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    background: rgba(5, 5, 6, 0.8);
    border-left: 2px solid;
    opacity: 0;
    transition: opacity 0.5s var(--ease);
    pointer-events: none;
  }
  .deep__air:global(.is-on) {
    opacity: 1;
  }
  .deep__air:global(.is-rejected) {
    opacity: 0.55;
    text-decoration: line-through;
  }
  .deep__air:global(.is-chosen)::after {
    content: ' · chosen';
    color: var(--fg);
  }
  .deep__beats[hidden] {
    display: none;
  }
  .deep__gl[hidden] {
    display: none;
  }
  .deep__pilot-label {
    display: none;
    position: absolute;
    top: 198px;
    left: var(--pad);
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg);
  }
  .deep[data-tab='pilot'] [data-pilot-label],
  .deep[data-tab='forest'] [data-recon-label] {
    display: block;
  }
  .deep[data-tab='pilot'] .deep__shade,
  .deep[data-tab='forest'] .deep__shade {
    background:
      linear-gradient(90deg, transparent calc(50% - 0.5px), var(--line) calc(50% - 0.5px), var(--line) calc(50% + 0.5px), transparent calc(50% + 0.5px)),
      linear-gradient(0deg, rgba(5, 7, 10, 0.92) 0%, transparent 44%);
  }
  .deep__pilot {
    position: absolute;
    right: var(--pad);
    bottom: 7vh;
    width: min(310px, calc(50% - 2 * var(--pad)));
    padding: 18px;
    border: 1px solid var(--line);
    background: rgba(5, 7, 8, 0.9);
    font-size: 10px;
  }
  .deep__pilot[hidden] {
    display: none;
  }
  .deep__pilot-status {
    color: var(--fg);
    font-size: 11px;
    line-height: 1.5;
    margin: 0 0 8px;
  }
  .deep__pilot-key,
  .deep__pilot-note {
    margin: 0;
    color: var(--fg-faint);
    font-size: 9px;
    line-height: 1.5;
  }
  .deep__pilot ol {
    display: grid;
    gap: 16px;
    list-style: none;
    margin: 18px 0;
    padding: 0;
  }
  .deep__pilot li {
    color: #ffbd64;
    transition: opacity 0.3s, color 0.3s;
  }
  .deep__pilot li:first-child {
    color: #ff775a;
  }
  .deep__pilot li:last-child {
    color: #a8e6ff;
  }
  .deep__pilot li > div {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  .deep__pilot b {
    font-weight: 400;
    white-space: nowrap;
  }
  .deep__pilot small {
    font-size: 9px;
    line-height: 1.5;
  }
  .deep__pilot-bar {
    display: block;
    height: 3px;
    margin: 7px 0;
    background: rgba(235, 233, 226, 0.1);
  }
  .deep__pilot-bar i {
    display: block;
    height: 100%;
    width: 0;
    background: currentColor;
    transition: width 0.4s;
  }
  .deep__pilot li:global(.is-rejected) {
    opacity: 0.5;
  }
  .deep__pilot li:global(.is-chosen)::after {
    content: 'Recommended';
    display: block;
    margin-top: 4px;
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .deep__tag--r {
    top: 198px;
  }
  .deep__hud {
    top: 226px;
  }
  .deep__product {
    position: absolute;
    top: 77px;
    left: var(--pad);
    right: var(--pad);
    z-index: 3;
    text-align: center;
    pointer-events: none;
  }
  .deep__product h2 { margin: 0; font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; }
  .deep__product p { margin: 5px 0 0; font-size: 12px; color: var(--fg-dim); }
  .deep__development {
    display: inline-block;
    margin-left: 9px;
    padding: 3px 7px;
    border: 1px solid rgba(255, 179, 71, 0.4);
    color: var(--accent);
    font-size: 9px;
    vertical-align: middle;
  }
  .deep__recon-cut {
    display: none;
    position: absolute;
    top: 0; left: 0; width: 50%; height: 100%;
    align-items: center; justify-content: center;
    background: #060b0d;
    opacity: var(--recon-cut-opacity, 0);
    pointer-events: none;
    z-index: 1;
    color: #bce5c9;
    font-size: 13px;
  }
  .deep[data-tab='forest'] .deep__recon-cut { display: flex; }
  .deep__recon-path-label {
    display: none;
    position: absolute;
    transform: translate(8px, -120%);
    padding: 6px 9px;
    border-left: 2px solid #9ae3b4;
    background: rgba(6, 17, 12, 0.9);
    color: #bce5c9;
    font-size: 10px;
    pointer-events: none;
  }
  .deep[data-tab='forest'] .deep__recon-path-label:not([hidden]) { display: block; }
  .deep__switch {
    position: absolute;
    top: 138px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px;
    background: rgba(5, 5, 6, 0.82);
    border: 1px solid var(--line);
    border-radius: 999px;
    pointer-events: auto;
    white-space: nowrap;
    max-width: calc(100% - 2 * var(--pad));
  }
  .deep__badge {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0 10px 0 12px;
  }
  .deep__switch button {
    font: inherit;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-dim);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 10px 18px;
    cursor: pointer;
    transition: color 0.3s, border-color 0.3s, background 0.3s;
  }
  .deep__switch button:hover {
    color: var(--fg);
    border-color: var(--fg-dim);
  }
  .deep__switch button[aria-selected='true'] {
    color: var(--bg);
    background: var(--fg);
    border-color: var(--fg);
  }
  .deep__switch button:focus-visible {
    outline: 1px solid var(--signal);
    outline-offset: 2px;
  }
  .deep.is-flat[data-tab='ground'] .deep__tag--r {
    display: none;
  }
  .deep.is-flat[data-tab='ground'] .deep__shade {
    background: linear-gradient(0deg, rgba(5, 5, 6, 0.92) 0%, rgba(5, 5, 6, 0) 46%);
  }

  .ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 12px;
  }
  .foot {
    position: relative;
    z-index: 1;
    background: var(--bg);
  }

  @media (min-width: 761px) and (max-width: 1000px) {
    .deep__badge {
      display: none;
    }
    .deep__switch button {
      font-size: 10px;
      padding: 10px 12px;
      letter-spacing: 0.08em;
    }
  }

  @media (max-width: 760px) {
    .reason__callout { max-width: 185px; padding: 8px 10px; gap: 3px; font-size: 10px; }
    .reason__callout--feature { top: 33%; right: var(--pad); }
    .vignette {
      background: linear-gradient(0deg, rgba(6, 7, 8, 0.9) 0%, rgba(6, 7, 8, 0.3) 60%, rgba(6, 7, 8, 0.4) 100%);
    }
    .sticky {
      align-items: flex-end;
      padding-bottom: 12vh;
    }
    .panel--right {
      margin-left: 0;
    }
    .versus {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .reason {
      padding: 12vh 0 8vh;
    }
    .deep__shade {
      background:
        linear-gradient(0deg, transparent calc(50% - 0.5px), var(--line) calc(50% - 0.5px), var(--line) calc(50% + 0.5px), transparent calc(50% + 0.5px)),
        linear-gradient(0deg, rgba(5, 5, 6, 0.95) 0%, rgba(5, 5, 6, 0) 40%);
    }
    .deep__tag--r,
    .deep__hud {
      left: var(--pad);
    }
    .deep__tag--r {
      top: calc(50% + 16px);
    }
    .deep__hud {
      top: calc(50% + 40px);
      gap: 12px;
    }
    .deep__copy {
      width: calc(100% - 2 * var(--pad));
      bottom: calc(5vh + 64px);
    }
    .deep__switch {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: calc(100% - 2 * var(--pad));
      gap: 4px;
      padding: 4px;
      border-radius: 20px;
      top: 118px;
    }
    .deep__badge {
      display: none;
    }
    .deep__switch button {
